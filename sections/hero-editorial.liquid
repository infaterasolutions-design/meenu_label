<style>
@media (max-width: 768px) {
  .snitch-hero-viewport {
    height: calc(100vw * 1.25) !important;
    min-height: 440px !important;
    max-height: 600px !important;
    width: 100% !important;
    max-width: 100% !important;
  }
  .slider-chevron { display: none !important; }
  .snitch-slide.snitch-slide-hero1 {
    background-image: url('{{ "banner_modern_ethnic_mob.jpg" | asset_url }}') !important;
    background-position: center center !important;
  }
}
</style>
<section class="snitch-hero-section">
  <div class="snitch-hero-viewport" id="heroSlider">
    <div class="snitch-track" id="sliderTrack">
      
      <!-- Slide 1: Modern Ethnic Elegance (LCP Preloaded Hero Banner) -->
      <div class="snitch-slide snitch-slide-hero1" style="background-image: url('{{ 'banner_modern_ethnic.jpg' | asset_url }}'); cursor: pointer;" onclick="window.location.href='/collections/all'" title="Shop Modern Ethnic Elegance">
      </div>

      <!-- Slide 2: Grace in Every Drape (Deferred Lazy Background) -->
      <div class="snitch-slide snitch-slide-hero2" data-bg-desktop="{{ 'banner_grace_in_every_drape.jpg' | asset_url }}" data-bg-mobile="{{ 'banner_grace_in_every_drape_mob.jpg' | asset_url }}" style="cursor: pointer;" onclick="window.location.href='/collections/all'" title="Shop Grace in Every Drape">
      </div>

      <!-- Slide 3: Everyday Dresses (Deferred Lazy Background) -->
      <div class="snitch-slide snitch-slide-hero3" data-bg-desktop="{{ 'banner_everyday_dresses.jpg' | asset_url }}" data-bg-mobile="{{ 'banner_everyday_dresses_mob.jpg' | asset_url }}" style="cursor: pointer;" onclick="window.location.href='/collections/dresses'" title="Shop Everyday Dresses Collection">
      </div>

      <!-- Slide 4: Chic Yellow Co-Ord Sets (Deferred Lazy Background) -->
      <div class="snitch-slide snitch-slide-hero4" data-bg-desktop="{{ 'banner_chic_yellow_coord.jpg' | asset_url }}" data-bg-mobile="{{ 'banner_chic_yellow_coord_mob.jpg' | asset_url }}" style="cursor: pointer;" onclick="window.location.href='/collections/co-ord-sets'" title="Shop Chic Yellow Co-Ord Collection">
      </div>

    </div>

    <!-- Navigation Chevrons -->
    <button class="slider-chevron chevron-prev" onclick="prevSlide()" aria-label="Previous Slide">&#x2039;</button>
    <button class="slider-chevron chevron-next" onclick="nextSlide()" aria-label="Next Slide">&#x203A;</button>

    <!-- Bottom Center Progress Dots -->
    <div class="slider-dots-wrap" id="sliderDots">
      <button class="slider-dot active" onclick="goToSlide(0)"></button>
      <button class="slider-dot" onclick="goToSlide(1)"></button>
      <button class="slider-dot" onclick="goToSlide(2)"></button>
      <button class="slider-dot" onclick="goToSlide(3)"></button>
    </div>
  </div>
</section>

<script>
  // Deferred Hero Slider Loader: Prioritizes Slide 1 LCP, then smoothly loads Slides 2-4
  function loadDeferredHeroSlides() {
    var isMob = window.innerWidth <= 768;
    var deferredSlides = document.querySelectorAll('.snitch-slide[data-bg-desktop]');
    deferredSlides.forEach(function(slide) {
      var bgUrl = isMob ? slide.getAttribute('data-bg-mobile') : slide.getAttribute('data-bg-desktop');
      if (bgUrl) {
        slide.style.backgroundImage = "url('" + bgUrl + "')";
        slide.removeAttribute('data-bg-desktop');
        slide.removeAttribute('data-bg-mobile');
      }
    });
  }

  // Load remaining slides after initial paint or immediately on interaction
  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadDeferredHeroSlides, { timeout: 1500 });
  } else {
    setTimeout(loadDeferredHeroSlides, 1000);
  }
  window.addEventListener('load', loadDeferredHeroSlides);
  var sliderEl = document.getElementById('heroSlider');
  if (sliderEl) {
    sliderEl.addEventListener('touchstart', loadDeferredHeroSlides, { passive: true, once: true });
    sliderEl.addEventListener('mouseenter', loadDeferredHeroSlides, { once: true });
  }
</script>

{% schema %}
{
  "name": "Snitch Luxury Carousel",
  "settings": []
}
{% endschema %}
