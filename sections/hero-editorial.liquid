
<style>
@media (max-width: 768px) {
  .snitch-hero-viewport {
    height: calc(100vw * 1.25) !important;
    min-height: 440px !important;
    max-height: 600px !important;
    width: 100% !important;
    max-width: 100% !important;
  }
  .slider-chevron { display: none !important; }
  .snitch-slide.snitch-slide-hero1 {
    background-image: url('{{ "banner_modern_ethnic_mob.jpg" | asset_url }}') !important;
    background-position: center center !important;
  }
  .snitch-slide.snitch-slide-hero2 {
    background-image: url('{{ "banner_grace_in_every_drape_mob.jpg" | asset_url }}') !important;
    background-position: center center !important;
  }
  .snitch-slide.snitch-slide-hero3 {
    background-image: url('{{ "banner_everyday_dresses_mob.jpg" | asset_url }}') !important;
    background-position: center center !important;
  }
  .snitch-slide.snitch-slide-hero4 {
    background-image: url('{{ "banner_chic_yellow_coord_mob.jpg" | asset_url }}') !important;
    background-position: center center !important;
  }
}
</style>
<section class="snitch-hero-section">
  <div class="snitch-hero-viewport" id="heroSlider">
    <div class="snitch-track" id="sliderTrack">
      
      <!-- Slide 1: Modern Ethnic Elegance (Flagship Hero Banner) -->
      <div class="snitch-slide snitch-slide-hero1" style="background-image: url('{{ 'banner_modern_ethnic.jpg' | asset_url }}'); cursor: pointer;" onclick="window.location.href='/collections/all'" title="Shop Modern Ethnic Elegance">
      </div>

      <!-- Slide 2: Grace in Every Drape (New Arrivals Hero Banner) -->
      <div class="snitch-slide snitch-slide-hero2" style="background-image: url('{{ 'banner_grace_in_every_drape.jpg' | asset_url }}'); cursor: pointer;" onclick="window.location.href='/collections/all'" title="Shop Grace in Every Drape">
      </div>

      <!-- Slide 3: Everyday Dresses (New Collection Hero Banner) -->
      <div class="snitch-slide snitch-slide-hero3" style="background-image: url('{{ 'banner_everyday_dresses.jpg' | asset_url }}'); cursor: pointer;" onclick="window.location.href='/collections/dresses'" title="Shop Everyday Dresses Collection">
      </div>

      <!-- Slide 4: Chic Yellow Co-Ord Sets (New Collection Hero Banner) -->
      <div class="snitch-slide snitch-slide-hero4" style="background-image: url('{{ 'banner_chic_yellow_coord.jpg' | asset_url }}'); cursor: pointer;" onclick="window.location.href='/collections/co-ord-sets'" title="Shop Chic Yellow Co-Ord Collection">
      </div>

    </div>

    <!-- Navigation Chevrons -->
    <button class="slider-chevron chevron-prev" onclick="prevSlide()" aria-label="Previous Slide">&#x2039;</button>
    <button class="slider-chevron chevron-next" onclick="nextSlide()" aria-label="Next Slide">&#x203A;</button>

    <!-- Bottom Center Progress Dots -->
    <div class="slider-dots-wrap" id="sliderDots">
      <button class="slider-dot active" onclick="goToSlide(0)"></button>
      <button class="slider-dot" onclick="goToSlide(1)"></button>
      <button class="slider-dot" onclick="goToSlide(2)"></button>
      <button class="slider-dot" onclick="goToSlide(3)"></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snitch Luxury Carousel",
  "settings": []
}
{% endschema %}
