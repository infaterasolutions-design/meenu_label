<style>
  .campaign-grid {
    display: grid !important;
    grid-template-columns: 1.38fr 1fr !important;
    gap: 24px !important;
    align-items: stretch !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }
  .campaign-hero-card {
    position: relative !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    min-height: 640px !important;
    background: #0D0D0D !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-end !important;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08) !important;
    cursor: pointer !important;
  }
  .campaign-hero-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 25% !important;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .campaign-hero-card:hover .campaign-hero-img {
    transform: scale(1.04) !important;
  }
  .campaign-hero-vignette {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.08) 0%,
      rgba(0, 0, 0, 0.15) 50%,
      rgba(0, 0, 0, 0.72) 80%,
      rgba(0, 0, 0, 0.94) 100%
    ) !important;
  }
  .campaign-hero-content {
    position: relative !important;
    z-index: 2 !important;
    padding: 36px 40px !important;
  }
  .campaign-hero-name {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: clamp(26px, 2.6vw, 34px) !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin: 0 0 6px !important;
    line-height: 1.2 !important;
  }
  .campaign-hero-meta {
    font-size: 13px !important;
    color: rgba(255, 255, 255, 0.85) !important;
    margin-bottom: 18px !important;
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
  }
  .campaign-price {
    font-size: 18px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
  }
  .campaign-mrp {
    font-size: 14px !important;
    color: rgba(255, 255, 255, 0.55) !important;
    text-decoration: line-through !important;
  }
  .campaign-hero-actions {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
  }
  .btn-campaign-primary {
    background: #FFFFFF !important;
    color: #000000 !important;
    border: none !important;
    padding: 12px 22px !important;
    border-radius: 6px !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    text-decoration: none !important;
  }
  .btn-campaign-primary:hover {
    background: #EAEAEA !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3) !important;
  }
  .btn-campaign-secondary {
    background: rgba(255, 255, 255, 0.15) !important;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    padding: 12px 20px !important;
    border-radius: 6px !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    cursor: pointer !important;
    backdrop-filter: blur(8px) !important;
    transition: all 0.2s ease !important;
    text-decoration: none !important;
  }
  .btn-campaign-secondary:hover {
    background: rgba(255, 255, 255, 0.3) !important;
    border-color: #FFFFFF !important;
  }

  /* Right Stack Column (2 Cards) */
  .campaign-stack {
    display: flex !important;
    flex-direction: column !important;
    gap: 24px !important;
  }
  .campaign-sub-card {
    position: relative !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    flex: 1 !important;
    min-height: 308px !important;
    background: #0D0D0D !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-end !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06) !important;
    cursor: pointer !important;
  }
  .campaign-sub-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 25% !important;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .campaign-sub-card:hover .campaign-sub-img {
    transform: scale(1.04) !important;
  }
  .campaign-sub-vignette {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.75) 80%,
      rgba(0, 0, 0, 0.94) 100%
    ) !important;
  }
  .campaign-sub-content {
    position: relative !important;
    z-index: 2 !important;
    padding: 24px 28px !important;
  }
  .campaign-sub-name {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 22px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin: 0 0 4px !important;
  }
  .campaign-sub-meta {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    margin-top: 10px !important;
  }
  .campaign-sub-price {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
  }
  .btn-campaign-sub {
    background: #FFFFFF !important;
    color: #000000 !important;
    border: none !important;
    padding: 8px 14px !important;
    border-radius: 4px !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    cursor: pointer !important;
    transition: background 0.15s !important;
    text-decoration: none !important;
  }
  .btn-campaign-sub:hover {
    background: #EAEAEA !important;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .campaign-grid {
      grid-template-columns: 1fr !important;
      gap: 18px !important;
    }
    .campaign-hero-card {
      min-height: 480px !important;
    }
    .campaign-hero-content {
      padding: 24px 20px !important;
    }
    .campaign-sub-card {
      min-height: 260px !important;
    }
    .campaign-sub-content {
      padding: 20px 20px !important;
    }
  }
</style>

<section class="campaign-edit-section">
  <div class="campaign-header">
    <span class="campaign-eyebrow">{{ section.settings.eyebrow | default: 'Atelier Capsule 01 &bull; Editorial Lookbook' }}</span>
    <h2 class="campaign-title">
      {{ section.settings.heading | default: 'THE CAMPAIGN EDIT: EFFORTLESS CHANDIGARH MORNINGS TO <span class="accent">REGAL EVENINGS</span>' }}
    </h2>
    <p class="campaign-sub">{{ section.settings.subheading | default: "Curated silhouettes styled in natural daylight across Chandigarh's iconic verandahs and promenades." }}</p>
  </div>

  {%- comment -%} Determine safe functional links with zero 404s {%- endcomment -%}
  {%- assign card1_url = section.settings.card1_url -%}
  {%- if section.settings.card1_product != blank -%}
    {%- assign card1_url = section.settings.card1_product.url -%}
  {%- endif -%}
  {%- if card1_url == blank or card1_url == '#' or card1_url contains 'jaipur-chanderi-silk-festive-suit' or card1_url == '/collections/all' -%}
    {%- assign card1_url = '/products/the-royal-wine-chanderi-festive-suit' -%}
  {%- endif -%}

  {%- assign card1_title = section.settings.card1_title -%}
  {%- if card1_title == blank or card1_title contains 'Jaipur' -%}
    {%- assign card1_title = 'The Royal Wine Chanderi Festive Suit' -%}
  {%- endif -%}

  {%- assign card1_price = section.settings.card1_price -%}
  {%- if card1_price == blank or card1_price contains '2,299' -%}
    {%- assign card1_price = '&#8377;2,799' -%}
  {%- endif -%}

  {%- assign card1_mrp = section.settings.card1_mrp -%}
  {%- if card1_mrp == blank or card1_mrp contains '3,699' -%}
    {%- assign card1_mrp = '&#8377;4,499' -%}
  {%- endif -%}

  {%- assign card2_url = section.settings.card2_url -%}
  {%- if section.settings.card2_product != blank -%}
    {%- assign card2_url = section.settings.card2_product.url -%}
  {%- endif -%}
  {%- if card2_url == blank or card2_url == '#' -%}
    {%- assign card2_url = '/collections/co-ord-sets' -%}
  {%- endif -%}

  {%- assign card2_title = section.settings.card2_title | default: 'Mustard Crepe Angrakha Co-ord' -%}

  {%- assign card3_url = section.settings.card3_url -%}
  {%- if section.settings.card3_product != blank -%}
    {%- assign card3_url = section.settings.card3_product.url -%}
  {%- endif -%}
  {%- if card3_url == blank or card3_url == '#' -%}
    {%- assign card3_url = '/collections/dresses' -%}
  {%- endif -%}

  {%- assign card3_title = section.settings.card3_title | default: 'White Porcelain Floral Wrap Dress' -%}

  <div class="campaign-grid">
    <!-- Left Main Feature (58%): The Royal Wine Chanderi Festive Suit (SKU: JAB26ST05010) -->
    <div class="campaign-hero-card" onclick="window.location.href='{{ card1_url }}'">
      {%- if section.settings.card1_image != blank -%}
        <img src="{{ section.settings.card1_image | img_url: '1200x' }}" alt="{{ card1_title | escape }}" class="campaign-hero-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'campaign_cafe.jpg' | asset_url }}" alt="{{ card1_title | escape }}" class="campaign-hero-img" loading="lazy">
      {%- endif -%}
      <div class="campaign-hero-vignette"></div>
      <div class="campaign-hero-content">
        <h3 class="campaign-hero-name">{{ card1_title }}</h3>
        <div class="campaign-hero-meta">
          <span class="campaign-price">{{ card1_price }}</span>
          <span class="campaign-mrp">{{ card1_mrp }}</span>
          <span style="font-size:11px; background:rgba(37,211,102,0.2); color:#25D366; padding:2px 8px; border-radius:12px; font-weight:700;">{{ section.settings.card1_discount | default: '38% OFF' }}</span>
          <span style="font-size:12px; color:rgba(255,255,255,0.7);">&bull; {{ section.settings.card1_fabric | default: 'Handcrafted Chanderi &amp; Zari' }}</span>
        </div>
        <div class="campaign-hero-actions" onclick="event.stopPropagation()">
          <a href="{{ card1_url }}" class="btn-campaign-primary">
            <span>SHOP SILHOUETTE</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
          <a href="{{ card1_url }}" class="btn-campaign-secondary">
            EXPLORE SUITS &rarr;
          </a>
        </div>
      </div>
    </div>

    <!-- Right Stack (42%): 2 Companion Silhouettes -->
    <div class="campaign-stack">
      <!-- Top Right Card: Mustard Crepe Angrakha Co-ord Set (SKU: SET974) -->
      <div class="campaign-sub-card" onclick="window.location.href='{{ card2_url }}'">
        {%- if section.settings.card2_image != blank -%}
          <img src="{{ section.settings.card2_image | img_url: '800x' }}" alt="{{ card2_title | escape }}" class="campaign-sub-img" loading="lazy">
        {%- else -%}
          <img src="{{ 'campaign_sukhna.jpg' | asset_url }}" alt="{{ card2_title | escape }}" class="campaign-sub-img" loading="lazy">
        {%- endif -%}
        <div class="campaign-sub-vignette"></div>
        <div class="campaign-sub-content">
          <h4 class="campaign-sub-name">{{ card2_title }}</h4>
          <p style="font-size:12px; color:rgba(255,255,255,0.75); margin:0 0 8px;">Gold Gota Trim with Side Tie-Up Tassels</p>
          <div class="campaign-sub-meta" onclick="event.stopPropagation()">
            <div>
              <span class="campaign-sub-price">{{ section.settings.card2_price | default: '&#8377;1,699' }}</span>
              <span style="font-size:11px; color:rgba(255,255,255,0.5); text-decoration:line-through; margin-left:6px;">{{ section.settings.card2_mrp | default: '&#8377;2,799' }}</span>
            </div>
            <a href="{{ card2_url }}" class="btn-campaign-sub">
              <span>SHOP LOOK</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Right Card: White Porcelain Floral Wrap Dress (SKU: JNE4046) -->
      <div class="campaign-sub-card" onclick="window.location.href='{{ card3_url }}'">
        {%- if section.settings.card3_image != blank -%}
          <img src="{{ section.settings.card3_image | img_url: '800x' }}" alt="{{ card3_title | escape }}" class="campaign-sub-img" loading="lazy">
        {%- else -%}
          <img src="{{ 'campaign_balcony.jpg' | asset_url }}" alt="{{ card3_title | escape }}" class="campaign-sub-img" loading="lazy">
        {%- endif -%}
        <div class="campaign-sub-vignette"></div>
        <div class="campaign-sub-content">
          <h4 class="campaign-sub-name">{{ card3_title }}</h4>
          <p style="font-size:12px; color:rgba(255,255,255,0.75); margin:0 0 8px;">Featherlight Georgette with Circular Waist Belt</p>
          <div class="campaign-sub-meta" onclick="event.stopPropagation()">
            <div>
              <span class="campaign-sub-price">{{ section.settings.card3_price | default: '&#8377;1,599' }}</span>
              <span style="font-size:11px; color:rgba(255,255,255,0.5); text-decoration:line-through; margin-left:6px;">{{ section.settings.card3_mrp | default: '&#8377;2,599' }}</span>
            </div>
            <a href="{{ card3_url }}" class="btn-campaign-sub">
              <span>SHOP LOOK</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

