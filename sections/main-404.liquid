<div id="custom404MyOrdersContainer" style="display:none; width:100%;">
  {% render 'my-orders-view' %}
</div>

<div id="standard404Content" class="page-404-container" style="max-width: 720px; margin: 80px auto; padding: 40px 20px; text-align: center; min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
  <span style="display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #9E7D47; background: rgba(158,125,71,0.12); border: 1px solid rgba(158,125,71,0.3); padding: 5px 14px; border-radius: 20px; margin-bottom: 18px;">
    Atelier Directory &bull; Error 404
  </span>
  <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(32px, 5vw, 48px); font-weight: 600; color: #141210; margin-bottom: 14px; line-height: 1.2;">
    Silhouette Not Found
  </h1>
  <p style="font-size: 15px; color: #7A7267; max-width: 460px; line-height: 1.6; margin-bottom: 32px;">
    The atelier piece or page you are seeking is either in private preparation or has moved to our latest capsule collection.
  </p>
  <div style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;">
    <a href="/" style="display: inline-flex; align-items: center; justify-content: center; background: #141210; color: #FAF8F5; padding: 14px 28px; border-radius: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; transition: background 0.2s;">
      Return to Storefront
    </a>
    <a href="/collections/all" style="display: inline-flex; align-items: center; justify-content: center; background: transparent; color: #141210; border: 1px solid #141210; padding: 14px 28px; border-radius: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; transition: background 0.2s;">
      Explore All Silhouettes
    </a>
  </div>
</div>

<script>
  if (window.location.pathname.indexOf('jaipur-chanderi-silk-festive-suit') !== -1) {
    window.location.replace('/products/the-royal-wine-chanderi-festive-suit');
  } else if (window.location.pathname.indexOf('my-orders') !== -1 || window.location.pathname.indexOf('orders') !== -1) {
    var ordersCont = document.getElementById('custom404MyOrdersContainer');
    var std404 = document.getElementById('standard404Content');
    if (ordersCont && std404) {
      ordersCont.style.display = 'block';
      std404.style.display = 'none';
      document.title = 'My Orders & Purchases — Meenu Label';
    }
  }
</script>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
