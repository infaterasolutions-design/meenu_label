<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF8F5">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>{{ page_title }} &bull; {{ shop.name }}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {{ 'meenu-luxury.css' | asset_url | stylesheet_tag }}

    <script>
      // Seamless redirect from legacy product slug to official product URL
      if (window.location.pathname.indexOf('jaipur-chanderi-silk-festive-suit') !== -1) {
        window.location.replace('/products/the-royal-wine-chanderi-festive-suit');
      }
      // Instant corrector for any legacy links on page
      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('a[href*="jaipur-chanderi-silk-festive-suit"]').forEach(function(el) {
          el.href = '/products/the-royal-wine-chanderi-festive-suit';
        });
      });
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    {% section 'announcement-bar' %}

    <div class="site-sticky-header-container" id="siteStickyHeaderContainer">
      {% section 'header' %}
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'nav-drawer' %}
    {% render 'wishlist-drawer' %}
    {% render 'size-guide-modal' %}
    {% render 'quick-size-modal' %}
  {% render 'notify-me-modal' %}
    {% render 'policy-modal' %}
    {% render 'whatsapp-concierge' %}
    {% render 'snitch-login-modal' %}

    <script src="{{ 'meenu-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
