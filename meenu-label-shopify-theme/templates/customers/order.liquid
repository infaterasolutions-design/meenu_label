<div class="customer-order-section" style="background: #FAF8F5; min-height: 85vh; padding: 40px 20px 80px;">
  <div class="customer-order-container" style="max-width: 1100px; margin: 0 auto;">
    
    <!-- Breadcrumb -->
    <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8C8275; margin-bottom: 24px;">
      <a href="/" style="color: inherit; text-decoration: none;">HOME</a> &nbsp;/&nbsp; 
      <a href="{{ routes.account_url }}" style="color: inherit; text-decoration: none;">MY ACCOUNT</a> &nbsp;/&nbsp; 
      <span style="color: #1E1C19;">ORDER {{ order.name }}</span>
    </div>

    <!-- Header Banner -->
    <div style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; padding: 28px 32px; margin-bottom: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.02);">
      <div>
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
          <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; background: #FAF7F2; border: 1px solid #EAE3D9; color: #9B7846; padding: 3px 10px; border-radius: 4px;">
            &#10024; ATELIER ORDER INVOICE
          </span>
          <span style="font-size: 11px; color: #8C8275; font-weight: 600;">Placed on {{ order.created_at | date: "%B %d, %Y at %I:%M %p" }}</span>
        </div>
        <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 34px; font-weight: 600; color: #1E1C19; margin: 0 0 4px 0;">
          Order {{ order.name }}
        </h1>
        
        <!-- Status Badges -->
        <div style="display: flex; gap: 8px; align-items: center; margin-top: 8px; flex-wrap: wrap;">
          {% if order.cancelled %}
            <span style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
              Cancelled on {{ order.cancelled_at | date: "%B %d, %Y" }} ({{ order.cancel_reason }})
            </span>
          {% else %}
            {% if order.financial_status == 'paid' %}
              <span style="background: #F3F8F2; border: 1px solid #D6E8D5; color: #2E6B38; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
                &#10003; Payment Paid
              </span>
            {% elsif order.financial_status == 'pending' %}
              <span style="background: #FFFBEB; border: 1px solid #FDE68A; color: #B45309; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
                Payment Pending (COD)
              </span>
            {% else %}
              <span style="background: #F5F3EF; border: 1px solid #E0DAD0; color: #6E6459; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
                {{ order.financial_status_label }}
              </span>
            {% endif %}

            {% if order.fulfillment_status == 'fulfilled' %}
              <span style="background: #F3F8F2; border: 1px solid #D6E8D5; color: #2E6B38; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
                &#128666; Dispatched / Delivered
              </span>
            {% else %}
              <span style="background: #FFF8EB; border: 1px solid #F7E4BE; color: #9B7846; font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 4px; text-transform: uppercase;">
                &#9203; Atelier Processing
              </span>
            {% endif %}
          {% endif %}
        </div>
      </div>

      <div>
        <a href="{{ routes.account_url }}" style="display: inline-block; padding: 10px 20px; border: 1px solid #D6CEC3; background: #FAF8F5; color: #1E1C19; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
          &larr; BACK TO ACCOUNT
        </a>
      </div>
    </div>

    <!-- Tracking Notification (If Fulfilled) -->
    {% for line_item in order.line_items %}
      {% if line_item.fulfillment %}
        <div style="background: #FAF7F2; border: 1px solid #EAE3D9; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div>
            <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #9B7846;">
              &#128230; SHIPMENT TRACKING AVAILABLE
            </div>
            <div style="font-size: 13px; color: #1E1C19; font-weight: 600; margin-top: 2px;">
              Carrier: {{ line_item.fulfillment.tracking_company }} &bull; Tracking No: {{ line_item.fulfillment.tracking_number }}
            </div>
          </div>
          {% if line_item.fulfillment.tracking_url %}
            <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" style="padding: 8px 16px; background: #1E1C19; color: #FFFFFF; font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
              TRACK SHIPMENT LIVE &rarr;
            </a>
          {% endif %}
        </div>
        {% break %}
      {% endif %}
    {% endfor %}

    <!-- Grid Layout: Items & Sidebar -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 28px; align-items: start;" class="order-grid-responsive">
      
      <!-- Order Items Section -->
      <div style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.02);">
        <h2 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 600; color: #1E1C19; margin: 0 0 20px 0; padding-bottom: 12px; border-bottom: 1px solid #F0EAE1;">
          Ordered Silhouettes
        </h2>

        <div style="display: flex; flex-direction: column; gap: 18px;">
          {% for line_item in order.line_items %}
            <div style="display: flex; gap: 16px; align-items: center; padding-bottom: 18px; border-bottom: 1px solid #F0EAE1;">
              {% if line_item.image %}
                <img src="{{ line_item.image | image_url: width: 160 }}" alt="{{ line_item.title }}" style="width: 75px; height: 95px; object-fit: cover; border-radius: 6px; border: 1px solid #EAE5DE;">
              {% endif %}
              
              <div style="flex: 1;">
                <a href="{{ line_item.url }}" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 600; color: #1E1C19; text-decoration: none; display: block; line-height: 1.3;">
                  {{ line_item.title }}
                </a>
                {% if line_item.variant.title != 'Default Title' %}
                  <div style="font-size: 12px; color: #8C8275; margin-top: 2px;">
                    Variant: {{ line_item.variant.title }}
                  </div>
                {% endif %}
                <div style="font-size: 12px; color: #8C8275; margin-top: 2px;">
                  Quantity: {{ line_item.quantity }} &times; {{ line_item.final_price | money }}
                </div>
              </div>

              <div style="text-align: right;">
                <div style="font-size: 15px; font-weight: 700; color: #1E1C19;">
                  {{ line_item.final_line_price | money }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Order Summary Totals -->
        <div style="margin-top: 24px; padding-top: 16px; border-top: 2px solid #1E1C19;">
          <div style="display: flex; justify-content: space-between; font-size: 13px; color: #6E6459; margin-bottom: 8px;">
            <span>Subtotal</span>
            <span style="font-weight: 600; color: #1E1C19;">{{ order.line_items_subtotal_price | money }}</span>
          </div>

          {% for discount in order.discounts %}
            <div style="display: flex; justify-content: space-between; font-size: 13px; color: #2E6B38; margin-bottom: 8px;">
              <span>Privilege Discount ({{ discount.code }})</span>
              <span>-{{ discount.amount | money }}</span>
            </div>
          {% endfor %}

          {% for shipping_method in order.shipping_methods %}
            <div style="display: flex; justify-content: space-between; font-size: 13px; color: #6E6459; margin-bottom: 8px;">
              <span>Shipping ({{ shipping_method.title }})</span>
              <span style="font-weight: 600; color: #1E1C19;">{{ shipping_method.price | money }}</span>
            </div>
          {% endfor %}

          {% for tax_line in order.tax_lines %}
            <div style="display: flex; justify-content: space-between; font-size: 13px; color: #6E6459; margin-bottom: 8px;">
              <span>Taxes ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
              <span style="font-weight: 600; color: #1E1C19;">{{ tax_line.price | money }}</span>
            </div>
          {% endfor %}

          <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: 16px; font-weight: 800; color: #1E1C19; margin-top: 14px; padding-top: 14px; border-top: 1px dashed #D6CEC3;">
            <span style="letter-spacing: 0.05em; text-transform: uppercase;">Total Paid / Payable</span>
            <span style="font-size: 20px; font-family: 'Cormorant Garamond', Georgia, serif;">{{ order.total_price | money }}</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Addresses & Support -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        
        <!-- Shipping Address -->
        <div style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.02);">
          <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #C5A059; margin-bottom: 4px;">
            DESTINATION
          </div>
          <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 600; color: #1E1C19; margin: 0 0 12px 0;">
            Shipping Address
          </h3>
          {% if order.shipping_address %}
            <div style="font-size: 12.5px; color: #4A4238; line-height: 1.6;">
              <strong>{{ order.shipping_address.name }}</strong><br>
              {{ order.shipping_address.address1 }}<br>
              {% if order.shipping_address.address2 != blank %}
                {{ order.shipping_address.address2 }}<br>
              {% endif %}
              {{ order.shipping_address.city }}, {{ order.shipping_address.province_code }} {{ order.shipping_address.zip }}<br>
              {{ order.shipping_address.country }}<br>
              {% if order.shipping_address.phone != blank %}
                Phone: {{ order.shipping_address.phone }}
              {% endif %}
            </div>
          {% else %}
            <div style="font-size: 12px; color: #8C8275;">No shipping address on record.</div>
          {% endif %}
        </div>

        <!-- Billing Address -->
        <div style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; padding: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.02);">
          <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #8C8275; margin-bottom: 4px;">
            BILLING DETAILS
          </div>
          <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 600; color: #1E1C19; margin: 0 0 12px 0;">
            Billing Address
          </h3>
          {% if order.billing_address %}
            <div style="font-size: 12.5px; color: #4A4238; line-height: 1.6;">
              <strong>{{ order.billing_address.name }}</strong><br>
              {{ order.billing_address.address1 }}<br>
              {% if order.billing_address.address2 != blank %}
                {{ order.billing_address.address2 }}<br>
              {% endif %}
              {{ order.billing_address.city }}, {{ order.billing_address.province_code }} {{ order.billing_address.zip }}<br>
              {{ order.billing_address.country }}
            </div>
          {% else %}
            <div style="font-size: 12px; color: #8C8275;">Same as shipping address.</div>
          {% endif %}
        </div>

        <!-- Atelier Concierge Support -->
        <div style="background: #FAF7F2; border: 1px solid #EAE3D9; border-radius: 12px; padding: 24px;">
          <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #9B7846; margin-bottom: 4px;">
            &#10024; CLIENT CONCIERGE
          </div>
          <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 19px; font-weight: 600; color: #1E1C19; margin: 0 0 8px 0;">
            Order Inquiries &amp; Exchanges
          </h3>
          <p style="font-size: 12px; color: #6E6459; line-height: 1.5; margin: 0 0 16px 0;">
            Questions regarding Order {{ order.name }}? Reach our Chandigarh atelier team directly for priority assistance.
          </p>

          <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20Order%20{{ order.name }}." target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; box-sizing: border-box; padding: 11px 0; background: #25D366; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
            WHATSAPP ABOUT ORDER {{ order.name }}
          </a>
        </div>

      </div>

    </div>

  </div>
</div>

<style>
  @media (max-width: 860px) {
    .order-grid-responsive {
      grid-template-columns: 1fr !important;
    }
  }
</style>
