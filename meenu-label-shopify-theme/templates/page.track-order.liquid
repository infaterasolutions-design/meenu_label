<script>
  function fillPageTrack(id) {
    var inp = document.getElementById('pageOrderTrackingInput');
    if (inp) {
      inp.value = id;
      executePageOrderTracking();
    }
  }

  function executePageOrderTracking() {
    var inp = document.getElementById('pageOrderTrackingInput');
    var val = inp ? inp.value.trim() : '';
    var err = document.getElementById('pageTrackingError');
    var container = document.getElementById('pageTrackingResultContainer');

    if (!val) {
      if (err) err.style.display = 'block';
      return;
    }
    if (err) err.style.display = 'none';

    // Synchronize into modal tracker and display
    var modalInp = document.getElementById('orderTrackingInput');
    if (modalInp) modalInp.value = val;
    executeOrderTracking();

    var modalResult = document.getElementById('trackingResultContainer');
    if (modalResult && container) {
      container.innerHTML = modalResult.innerHTML;
      container.style.display = 'block';
      container.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  // Pre-fill last search
  window.addEventListener('DOMContentLoaded', function() {
    try {
      var last = localStorage.getItem('meenu_last_order');
      if (last) {
        var inp = document.getElementById('pageOrderTrackingInput');
        if (inp) inp.value = last;
      }
    } catch(e) {}
  });
</script>
