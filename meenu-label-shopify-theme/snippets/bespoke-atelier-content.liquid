{% comment %}
  Meenu Label — Dedicated Bespoke Atelier Experience (/pages/bespoke)
  Blocks A–E: Hero Walkthrough, Live Mohali Adda Reels (up to 25, lazy preview modal),
  Craft Archives (4-col), Pure Silk & Custom Shade Selector, 4-Step Couture Concierge & Form.
{% endcomment %}

{%- assign raw_wa = section.settings.whatsapp_number | default: settings.whatsapp_number | default: '918511616133' -%}
{%- assign wa_digits = raw_wa | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
{%- if section.settings.explainer_fallback_image != blank -%}
  {%- assign hero_poster = section.settings.explainer_fallback_image | image_url: width: 960 -%}
{%- elsif section.settings.explainer_video != blank and section.settings.explainer_video.preview_image != blank -%}
  {%- assign hero_poster = section.settings.explainer_video.preview_image | image_url: width: 960 -%}
{%- else -%}
  {%- assign hero_poster = 'campaign_sukhna.jpg' | asset_url -%}
{%- endif -%}

<div class="bespoke-page-wrap" id="bespokeAtelierRoot-{{ section.id }}">

  <!-- Top Breadcrumb Bar -->
  <div class="bespoke-top-bar">
    <nav class="bespoke-breadcrumb" aria-label="Breadcrumb">
      <a href="/">HOME</a>
      <span aria-hidden="true">/</span>
      <span class="bespoke-breadcrumb-current">BESPOKE ATELIER</span>
    </nav>
  </div>

  <!-- BLOCK A: Explainer Hero Walkthrough -->
  <section class="bespoke-hero-surface" aria-labelledby="bespoke-hero-h1-{{ section.id }}">
    <div class="bespoke-hero-grid">
      <!-- Intro (Right Top on Desktop, First on Mobile) -->
      <div class="bespoke-hero-intro">
        <span class="bespoke-kicker">{{ section.settings.hero_eyebrow | default: 'MOHALI & CHANDIGARH ATELIER • PRIVATE COMMISSIONS' }}</span>
        <h1 class="bespoke-h1" id="bespoke-hero-h1-{{ section.id }}">
          CRAFTED FOR ONE WOMAN <span class="bespoke-h1-accent">at a Time</span>
        </h1>
        <p class="bespoke-hero-sub">{{ section.settings.hero_subtitle | default: 'No Add to Cart — Every Piece Custom Dyed & Embroidered to Commission' }}</p>
      </div>

      <!-- Spoken Influencer Walkthrough Player (Left on Desktop, Second on Mobile) -->
      <div class="bespoke-hero-media">
        <div class="bespoke-hero-video-box" data-bespoke-hero-player="{{ section.id }}">
          {% if section.settings.explainer_video != blank %}
            <video
              class="bespoke-hero-video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="{{ hero_poster }}"
              aria-label="Meenu Label Mohali & Chandigarh Atelier Walkthrough">
              {% for source in section.settings.explainer_video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
              {% if section.settings.subtitle_vtt_url != blank %}
                <track
                  kind="subtitles"
                  srclang="en"
                  label="English"
                  src="{{ section.settings.subtitle_vtt_url }}"
                  default>
              {% endif %}
            </video>
            <button
              type="button"
              class="bespoke-hero-sound-pill"
              data-bespoke-hero-sound-btn
              aria-label="Tap to hear the bespoke walkthrough with sound from start">
              <span aria-hidden="true">&#128266;</span>
              <span>TAP TO HEAR THE PROCESS (WITH SOUND)</span>
            </button>
          {% else %}
            <img
              src="{{ hero_poster }}"
              alt="Meenu Label Mohali & Chandigarh Atelier couture embroidery"
              class="bespoke-hero-img"
              width="960"
              height="1200">
            <a href="#adda-reels" class="bespoke-hero-sound-pill">
              <span aria-hidden="true">&#9654;</span>
              <span>WATCH MOHALI ADDA REELS</span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Takeaways & Consultation CTAs (Right Bottom on Desktop, Third on Mobile) -->
      <div class="bespoke-hero-details">
        <ol class="bespoke-takeaway-list">
          <li class="bespoke-takeaway-card">
            <span class="bespoke-takeaway-idx">01.</span>
            <div>
              <strong>{{ section.settings.takeaway_1_title | default: 'Your Design or Our Adda Archives — Zero Limitations' }}</strong>
              <p>{{ section.settings.takeaway_1_desc | default: 'Commission an archival zardozi motif or share your own bridal or festive reference.' }}</p>
            </div>
          </li>
          <li class="bespoke-takeaway-card">
            <span class="bespoke-takeaway-idx">02.</span>
            <div>
              <strong>{{ section.settings.takeaway_2_title | default: 'Live Daylight Dye & Shade Video Approval Before Stitching' }}</strong>
              <p>{{ section.settings.takeaway_2_desc | default: 'Review natural daylight silk and resham thread clips on WhatsApp prior to embroidery.' }}</p>
            </div>
          </li>
          <li class="bespoke-takeaway-card">
            <span class="bespoke-takeaway-idx">03.</span>
            <div>
              <strong>{{ section.settings.takeaway_3_title | default: 'Zero-Tape Flat Suit Fit & Mohali Karigar Progress Clips' }}</strong>
              <p>{{ section.settings.takeaway_3_desc | default: 'Measure from an existing favorite suit laid flat and follow progress straight from Mohali.' }}</p>
            </div>
          </li>
        </ol>

        <div class="bespoke-hero-actions">
          <a href="#bespoke-consultation-form" class="bespoke-btn-dark">
            REQUEST PRIVATE CONSULTATION &rarr;
          </a>
          <a
            href="https://wa.me/{{ wa_digits }}?text={{ 'Hello Meenu Label Mohali & Chandigarh Atelier! I would like to book a bespoke commission consultation.' | url_encode }}"
            target="_blank"
            rel="noopener noreferrer"
            class="bespoke-btn-wa">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.77.818 2.788.818 3.18 0 5.767-2.587 5.767-5.766.001-3.182-2.585-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.077-1.748-.358-.871-.362-1.579-.909-2.185-1.515-.606-.606-1.153-1.314-1.515-2.185-.435-1.05-.403-1.436-.358-1.748.05-.333.419-1.026.824-1.17.135-.048.281-.072.417-.072.106 0 .211.004.306.012.235.018.351.042.507.414.193.459.66 1.606.717 1.723.058.117.098.253.02.408-.078.156-.118.254-.234.39-.118.136-.248.305-.353.41-.118.118-.241.246-.104.482.137.235.61 1.003 1.309 1.626.899.801 1.657 1.049 1.892 1.166.236.118.373.104.51-.054.137-.156.587-.685.744-.92.156-.235.313-.195.528-.117.215.078 1.365.644 1.599.761.234.117.391.176.449.274.058.098.058.566-.086.971zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.434 5.176L2 22l4.958-1.399C8.423 21.499 10.153 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/></svg>
            <span>WHATSAPP ATELIER CONCIERGE</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOCK B: Inside the Mohali Adda: Live Karigar Reels (up to 25, zero video tags on initial load) -->
  <section id="adda-reels" class="bespoke-block bespoke-reels-block" aria-labelledby="bespoke-reels-heading-{{ section.id }}">
    <div class="bespoke-section-head">
      <div>
        <span class="bespoke-kicker">BEHIND THE WOODEN ADDA &bull; ZERO SCRIPT, REAL WORKMANSHIP</span>
        <h2 class="bespoke-h2 bespoke-h2-left" id="bespoke-reels-heading-{{ section.id }}">
          INSIDE THE MOHALI ADDA: <span class="bespoke-h2-accent">Live Karigar Reels</span>
        </h2>
      </div>
      <div class="bespoke-strip-arrows" aria-hidden="true">
        <button type="button" class="bespoke-strip-chevron" data-reel-scroll="prev" aria-label="Scroll reels left">&#10094;</button>
        <button type="button" class="bespoke-strip-chevron" data-reel-scroll="next" aria-label="Scroll reels right">&#10095;</button>
      </div>
    </div>

    <!-- Filter Pills -->
    <div class="bespoke-filter-pills" role="tablist" aria-label="Filter live adda reels by embroidery craft">
      <button type="button" class="bespoke-filter-pill is-active" data-reel-filter="All" role="tab" aria-selected="true">All</button>
      <button type="button" class="bespoke-filter-pill" data-reel-filter="Zardozi &amp; Dabka" role="tab" aria-selected="false">Zardozi &amp; Dabka</button>
      <button type="button" class="bespoke-filter-pill" data-reel-filter="Resham Floral" role="tab" aria-selected="false">Resham Floral</button>
      <button type="button" class="bespoke-filter-pill" data-reel-filter="Cut-Work Jaali" role="tab" aria-selected="false">Cut-Work Jaali</button>
      <button type="button" class="bespoke-filter-pill" data-reel-filter="Ghera Borders" role="tab" aria-selected="false">Ghera Borders</button>
    </div>

    {%- assign reel_fallbacks = 'craft_chanderi.jpg,campaign_balcony.jpg,craft_organza.jpg,campaign_cafe.jpg,craft_crepe.jpg,campaign_jaipur_chanderi.jpg' | split: ',' -%}

    <!-- Lightweight Image-Only 9:16 Horizontal Strip -->
    <div class="bespoke-reels-track" id="bespokeReelsTrack-{{ section.id }}">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- assign fb_idx = forloop.index0 | modulo: 6 -%}
          {%- assign reel_poster = reel_fallbacks[fb_idx] | asset_url -%}
          {%- if block.settings.video != blank and block.settings.video.preview_image != blank -%}
            {%- assign reel_poster = block.settings.video.preview_image | image_url: width: 540 -%}
          {%- endif -%}
          <button
            type="button"
            class="bespoke-reel-card"
            data-reel-index="{{ forloop.index0 }}"
            data-reel-category="{{ block.settings.craft_category | default: 'All' | escape }}"
            aria-label="Play {{ block.settings.craft_title | escape }} ({{ block.settings.duration_tag | default: '0:08' }})"
            {{ block.shopify_attributes }}>
            <img
              src="{{ reel_poster }}"
              alt="{{ block.settings.craft_title | escape }}"
              class="bespoke-reel-poster"
              loading="lazy"
              width="405"
              height="720">
            <span class="bespoke-reel-duration">
              <span class="bespoke-reel-rec-dot" aria-hidden="true"></span>
              <span>{{ block.settings.duration_tag | default: '0:08' }}</span>
            </span>
            <span class="bespoke-reel-play-icon" aria-hidden="true">&#9654;</span>
            <span class="bespoke-reel-caption-wrap">
              <span class="bespoke-reel-cat-mini">{{ block.settings.craft_category }}</span>
              <span class="bespoke-reel-title">{{ block.settings.craft_title }}</span>
            </span>
          </button>
        {% endfor %}
      {% else %}
        {%- assign default_titles = 'Dabka & French Knot Work on Ivory Chanderi,Gulabi Resham Booti Shading,Delicate Scallop Cut-Work Jaali,Antiqued Tilla Ghera Border,Silk Thread Satin Stitch,Mohali Karigar Final Finishing' | split: ',' -%}
        {%- assign default_cats = 'Zardozi & Dabka,Resham Floral,Cut-Work Jaali,Ghera Borders,Resham Floral,Zardozi & Dabka' | split: ',' -%}
        {%- assign default_durs = '0:09,0:11,0:08,0:10,0:07,0:12' | split: ',' -%}
        {% for fb_idx in (0..5) %}
          <button
            type="button"
            class="bespoke-reel-card"
            data-reel-index="{{ fb_idx }}"
            data-reel-category="{{ default_cats[fb_idx] | escape }}"
            aria-label="Play {{ default_titles[fb_idx] | escape }}">
            <img
              src="{{ reel_fallbacks[fb_idx] | asset_url }}"
              alt="{{ default_titles[fb_idx] | escape }}"
              class="bespoke-reel-poster"
              loading="lazy"
              width="405"
              height="720">
            <span class="bespoke-reel-duration">
              <span class="bespoke-reel-rec-dot" aria-hidden="true"></span>
              <span>{{ default_durs[fb_idx] }}</span>
            </span>
            <span class="bespoke-reel-play-icon" aria-hidden="true">&#9654;</span>
            <span class="bespoke-reel-caption-wrap">
              <span class="bespoke-reel-cat-mini">{{ default_cats[fb_idx] }}</span>
              <span class="bespoke-reel-title">{{ default_titles[fb_idx] }}</span>
            </span>
          </button>
        {% endfor %}
      {% endif %}
    </div>

    <!-- JSON metadata for on-demand single-video lightbox mounting -->
    <script type="application/json" id="bespokeReelsData-{{ section.id }}">
      [
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {%- assign fb_idx = forloop.index0 | modulo: 6 -%}
            {%- assign reel_poster = reel_fallbacks[fb_idx] | asset_url -%}
            {%- if block.settings.video != blank and block.settings.video.preview_image != blank -%}
              {%- assign reel_poster = block.settings.video.preview_image | image_url: width: 720 -%}
            {%- endif -%}
            {
              "index": {{ forloop.index0 }},
              "title": {{ block.settings.craft_title | json }},
              "category": {{ block.settings.craft_category | default: 'All' | json }},
              "duration": {{ block.settings.duration_tag | default: '0:08' | json }},
              "poster": {{ reel_poster | json }},
              "sources": [
                {% if block.settings.video != blank %}
                  {% for source in block.settings.video.sources %}
                    { "url": {{ source.url | json }}, "type": {{ source.mime_type | json }} }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                {% endif %}
              ]
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        {% else %}
          {% for fb_idx in (0..5) %}
            {
              "index": {{ fb_idx }},
              "title": {{ default_titles[fb_idx] | json }},
              "category": {{ default_cats[fb_idx] | json }},
              "duration": {{ default_durs[fb_idx] | json }},
              "poster": {{ reel_fallbacks[fb_idx] | asset_url | json }},
              "sources": []
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        {% endif %}
      ]
    </script>
  </section>

  <!-- BLOCK C: From the Wooden Adda: Craft Archives -->
  <section class="bespoke-block" aria-labelledby="bespoke-archives-heading-{{ section.id }}">
    <div class="bespoke-section-head bespoke-section-head-center">
      <span class="bespoke-kicker">HEIRLOOM SILHOUETTES &bull; MADE TO ORDER</span>
      <h2 class="bespoke-h2" id="bespoke-archives-heading-{{ section.id }}">
        FROM THE WOODEN ADDA: <span class="bespoke-h2-accent">Craft Archives</span>
      </h2>
      <p class="bespoke-section-sub">Select an archive signature to commission in your custom measurements and shade.</p>
    </div>

    <div class="bespoke-archives-grid">
      {%- assign archive_default_imgs = 'craft_chanderi.jpg,campaign_balcony.jpg,campaign_jaipur_chanderi.jpg,craft_organza.jpg' | split: ',' -%}
      {%- assign archive_default_badges = 'ARCHIVE 01,ARCHIVE 02,ARCHIVE 03,ARCHIVE 04' | split: ',' -%}
      {%- assign archive_default_titles = 'Ivory Resham & Cut-Dana Floral|Rose Adda Zardozi & Paisley Hem|Midnight Lattice Cut-Work Jaali|Heritage Jamawar Heirloom' | split: '|' -%}
      {%- assign archive_default_prices = 'Commission from ₹8,999|From ₹10,999|From ₹12,999|From ₹18,999' | split: '|' -%}

      {% for num in (1..4) %}
        {%- assign fb_idx = forloop.index0 -%}
        {%- assign img_key = 'archive_' | append: num | append: '_image' -%}
        {%- assign badge_key = 'archive_' | append: num | append: '_badge' -%}
        {%- assign title_key = 'archive_' | append: num | append: '_title' -%}
        {%- assign price_key = 'archive_' | append: num | append: '_price' -%}
        {%- assign lead_key = 'archive_' | append: num | append: '_lead' -%}

        {%- assign card_img = archive_default_imgs[fb_idx] | asset_url -%}
        {%- if section.settings[img_key] != blank -%}
          {%- assign card_img = section.settings[img_key] | image_url: width: 720 -%}
        {%- endif -%}
        {%- assign card_badge = section.settings[badge_key] | default: archive_default_badges[fb_idx] -%}
        {%- assign card_title = section.settings[title_key] | default: archive_default_titles[fb_idx] -%}
        {%- assign card_price = section.settings[price_key] | default: archive_default_prices[fb_idx] -%}
        {%- assign card_lead = section.settings[lead_key] | default: '12–14 Days' -%}
        {%- assign wa_archive_msg = 'Hello Meenu Label Mohali & Chandigarh Atelier! I would like to customize ' | append: card_badge | append: ': ' | append: card_title | append: ' (' | append: card_price | append: ').' -%}

        <article class="bespoke-archive-card">
          <div class="bespoke-archive-media">
            <img src="{{ card_img }}" alt="{{ card_badge | escape }} — {{ card_title | escape }}" loading="lazy" width="600" height="750">
            <span class="bespoke-archive-badge">{{ card_badge }}</span>
          </div>
          <div class="bespoke-archive-body">
            <h3 class="bespoke-archive-title">{{ card_title }}</h3>
            <div class="bespoke-archive-meta">
              <span class="bespoke-archive-price">{{ card_price }}</span>
              <span class="bespoke-archive-dot" aria-hidden="true">&bull;</span>
              <span class="bespoke-archive-lead">{{ card_lead }}</span>
            </div>
            <a
              href="https://wa.me/{{ wa_digits }}?text={{ wa_archive_msg | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="bespoke-archive-cta">
              CUSTOMIZE THIS CRAFT &rarr;
            </a>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <!-- BLOCK D: Interactive Pure Silk & Custom Shade Selector -->
  <section class="bespoke-block" aria-labelledby="bespoke-shade-heading-{{ section.id }}">
    <div class="bespoke-shade-card">
      <div class="bespoke-section-head bespoke-section-head-center" style="margin-bottom:26px;">
        <span class="bespoke-kicker">HAND-DYED TO ORDER IN MOHALI &bull; LIVE DAYLIGHT APPROVAL</span>
        <h2 class="bespoke-h2" id="bespoke-shade-heading-{{ section.id }}">
          PURE SILK &amp; <span class="bespoke-h2-accent">Custom Shade Selector</span>
        </h2>
      </div>

      <div class="bespoke-shade-controls">
        <!-- Circular Dye Swatches -->
        <div class="bespoke-swatch-group">
          <div class="bespoke-control-label">1. Select Your Bespoke Dye Shade</div>
          <div class="bespoke-swatches-row" role="radiogroup" aria-label="Select custom dye shade">
            <button type="button" class="bespoke-swatch-btn is-selected" data-shade-name="Ivory Pearl" role="radio" aria-checked="true">
              <span class="bespoke-swatch-circle" style="background:#F4EFE6;"></span>
              <span class="bespoke-swatch-name">Ivory Pearl</span>
            </button>
            <button type="button" class="bespoke-swatch-btn" data-shade-name="Gulabi Rose" role="radio" aria-checked="false">
              <span class="bespoke-swatch-circle" style="background:#D87A88;"></span>
              <span class="bespoke-swatch-name">Gulabi Rose</span>
            </button>
            <button type="button" class="bespoke-swatch-btn" data-shade-name="Royal Burgundy" role="radio" aria-checked="false">
              <span class="bespoke-swatch-circle" style="background:#6D1E2E;"></span>
              <span class="bespoke-swatch-name">Royal Burgundy</span>
            </button>
            <button type="button" class="bespoke-swatch-btn" data-shade-name="Petrol Teal" role="radio" aria-checked="false">
              <span class="bespoke-swatch-circle" style="background:#1D4E56;"></span>
              <span class="bespoke-swatch-name">Petrol Teal</span>
            </button>
            <button type="button" class="bespoke-swatch-btn" data-shade-name="Almond Champagne" role="radio" aria-checked="false">
              <span class="bespoke-swatch-circle" style="background:#DFC8A8;"></span>
              <span class="bespoke-swatch-name">Almond Champagne</span>
            </button>
            <button type="button" class="bespoke-swatch-btn" data-shade-name="Emerald Forest" role="radio" aria-checked="false">
              <span class="bespoke-swatch-circle" style="background:#1E4D3B;"></span>
              <span class="bespoke-swatch-name">Emerald Forest</span>
            </button>
          </div>
        </div>

        <!-- Base Fabrics -->
        <div class="bespoke-fabric-group">
          <div class="bespoke-control-label">2. Select Your Pure Base Silk</div>
          <div class="bespoke-fabric-pills" role="radiogroup" aria-label="Select base silk fabric">
            <button type="button" class="bespoke-filter-pill is-active" data-fabric-name="Pure Chanderi Silk" role="radio" aria-checked="true">Pure Chanderi Silk</button>
            <button type="button" class="bespoke-filter-pill" data-fabric-name="Pure Raw Silk" role="radio" aria-checked="false">Pure Raw Silk</button>
            <button type="button" class="bespoke-filter-pill" data-fabric-name="Organza" role="radio" aria-checked="false">Organza</button>
            <button type="button" class="bespoke-filter-pill" data-fabric-name="Muslin" role="radio" aria-checked="false">Muslin</button>
          </div>
        </div>
      </div>

      <!-- Dynamic Live Confirmation Bar -->
      <div class="bespoke-shade-confirm" id="bespokeShadeConfirm-{{ section.id }}" aria-live="polite">
        <span class="bespoke-shade-dot" id="bespokeShadeDot-{{ section.id }}" style="background:#F4EFE6;"></span>
        <span class="bespoke-shade-confirm-text" id="bespokeShadeText-{{ section.id }}">
          Selected: <strong>Ivory Pearl</strong> &bull; Real daylight shade video sent on WhatsApp before adda work begins <span class="bespoke-fabric-echo">(Base: Pure Chanderi Silk)</span>
        </span>
      </div>
    </div>
  </section>

  <!-- BLOCK E: 4-Step Couture Concierge & Private Consultation Form -->
  <section class="bespoke-block" id="bespoke-consultation-form" aria-labelledby="bespoke-concierge-heading-{{ section.id }}">
    <div class="bespoke-section-head bespoke-section-head-center">
      <span class="bespoke-kicker">TRANSPARENT MOHALI &amp; CHANDIGARH PROCESS</span>
      <h2 class="bespoke-h2" id="bespoke-concierge-heading-{{ section.id }}">
        FOUR STEPS TO YOUR <span class="bespoke-h2-accent">Bespoke Commission</span>
      </h2>
    </div>

    <div class="bespoke-steps-grid">
      <div class="bespoke-step-card">
        <span class="bespoke-step-num">STEP 01</span>
        <h3 class="bespoke-step-title">Share Reference Photo or Pick Archive</h3>
        <p class="bespoke-step-desc">Send an inspiration image, family heirloom reference, or pick a signature craft archive with our Mohali &amp; Chandigarh Atelier.</p>
      </div>
      <div class="bespoke-step-card">
        <span class="bespoke-step-num">STEP 02</span>
        <h3 class="bespoke-step-title">Live Dye Shade Video Approval</h3>
        <p class="bespoke-step-desc">We dye a real silk &amp; resham thread swatch and share a natural-daylight WhatsApp video for your sign-off before embroidery starts.</p>
      </div>
      <div class="bespoke-step-card">
