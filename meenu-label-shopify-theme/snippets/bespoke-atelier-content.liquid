    }
    .bespoke-filter-pills::-webkit-scrollbar {
      display: none;
    }
    .bespoke-filter-pill {
      flex-shrink: 0;
      padding: 7px 14px;
      font-size: 11px;
    }
    .bespoke-reels-track {
      margin: 0 -14px;
      padding: 0 14px 8px;
      gap: 12px;
    }
    /* ~2.2 cards visible on 375px mobile */
    .bespoke-reel-card {
      flex: 0 0 43.5%;
      min-width: 148px;
      max-width: none;
    }
