  .bespoke-form-card {
    max-width: 860px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E8E2D8;
    border-radius: 12px;
    padding: 36px;
    box-shadow: 0 12px 32px rgba(20, 18, 16, 0.04);
  }
  .bespoke-form-head {
    text-align: center;
    margin-bottom: 26px;
  }
  .bespoke-form-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(24px, 2.8vw, 32px);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin: 0 0 8px;
    color: #141210;
  }
  .bespoke-form-sub {
    font-size: 13px;
    color: #7A7267;
    margin: 0 auto;
    max-width: 560px;
