    font-size: 13.5px;
    color: #141210;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .bespoke-field input:focus,
  .bespoke-field select:focus,
  .bespoke-field textarea:focus {
    border-color: #9E7D47;
