    color: #9E7D47;
    font-weight: 600;
  }

  /* Block E: 4 Steps + Form */
  .bespoke-steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 36px;
  }
  .bespoke-step-card {
