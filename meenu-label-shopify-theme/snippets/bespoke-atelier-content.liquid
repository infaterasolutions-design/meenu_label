</style>

<script>
  (function () {
    var root = document.getElementById('bespokeAtelierRoot-{{ section.id }}');
    if (!root) return;
    var waNumber = '{{ wa_digits }}';

    /* 1. Block A: Spoken Walkthrough Tap-to-Hear Player */
    var heroPlayer = root.querySelector('[data-bespoke-hero-player="{{ section.id }}"]');
    if (heroPlayer) {
      var heroVideo = heroPlayer.querySelector('video');
      var heroPill = heroPlayer.querySelector('[data-bespoke-hero-sound-btn]');
      if (heroVideo && heroPill) {
        function startHeroSound(e) {
          if (heroPlayer.classList.contains('is-playing-sound')) return;
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          try {
            heroVideo.currentTime = 0;
          } catch (err) {}
          heroVideo.muted = false;
          heroVideo.loop = false;
          heroVideo.controls = true;
          heroPlayer.classList.add('is-playing-sound');
          var p = heroVideo.play();
          if (p && typeof p.catch === 'function') {
            p.catch(function () {});
          }
        }
        heroPill.addEventListener('click', startHeroSound);
        heroPlayer.addEventListener('click', function (e) {
          if (!heroPlayer.classList.contains('is-playing-sound') && e.target !== heroPill && !heroPill.contains(e.target)) {
            startHeroSound(e);
          }
        });
      }
    }

    /* 2. Block B: Live Karigar Reels Filtering + On-Demand Single-Video Modal */
    var reelsTrack = document.getElementById('bespokeReelsTrack-{{ section.id }}');
    var dataEl = document.getElementById('bespokeReelsData-{{ section.id }}');
    var reelsData = [];
    try {
      reelsData = dataEl ? JSON.parse(dataEl.textContent) : [];
    } catch (e) {
      reelsData = [];
    }

    var filterBtns = root.querySelectorAll('[data-reel-filter]');
    var reelCards = root.querySelectorAll('.bespoke-reel-card');
    var activeFilter = 'All';

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeFilter = btn.getAttribute('data-reel-filter') || 'All';
        filterBtns.forEach(function (b) {
          var isSel = b === btn;
          b.classList.toggle('is-active', isSel);
          b.setAttribute('aria-selected', isSel ? 'true' : 'false');
        });
        reelCards.forEach(function (card) {
          var cat = card.getAttribute('data-reel-category') || 'All';
          var match = activeFilter === 'All' || cat === activeFilter || cat === 'All';
          card.classList.toggle('is-hidden-filter', !match);
        });
        if (reelsTrack) reelsTrack.scrollTo({ left: 0, behavior: 'smooth' });
      });
    });

    root.querySelectorAll('[data-reel-scroll]').forEach(function (arrow) {
      arrow.addEventListener('click', function () {
        if (!reelsTrack) return;
        var dir = arrow.getAttribute('data-reel-scroll') === 'prev' ? -1 : 1;
        reelsTrack.scrollBy({ left: dir * 320, behavior: 'smooth' });
      });
    });

    var modal = document.getElementById('bespokeReelModal-{{ section.id }}');
    var modalStage = document.getElementById('bespokeModalStage-{{ section.id }}');
    var modalCat = document.getElementById('bespokeModalCat-{{ section.id }}');
    var modalTitle = document.getElementById('bespokeModalTitle-{{ section.id }}');
    var modalWaBtn = document.getElementById('bespokeModalWaBtn-{{ section.id }}');
    var modalMuteBtn = document.getElementById('bespokeModalMuteBtn-{{ section.id }}');
    var modalPrev = document.getElementById('bespokeModalPrev-{{ section.id }}');
    var modalNext = document.getElementById('bespokeModalNext-{{ section.id }}');
    var currentVisibleIndices = [];
    var currentPos = 0;

    function unloadModalVideo() {
      if (!modalStage) return;
      var v = modalStage.querySelector('video');
      if (v) {
        try {
          v.pause();
          v.removeAttribute('src');
          v.innerHTML = '';
          v.load();
        } catch (err) {}
      }
      modalStage.innerHTML = '';
      if (modalMuteBtn) modalMuteBtn.style.display = 'none';
    }

    function renderReelInModal(reelIdx) {
      var item = reelsData.find(function (r) { return r.index === reelIdx; }) || reelsData[0];
      if (!item || !modalStage) return;

      unloadModalVideo();
      if (modalCat) modalCat.textContent = item.category || 'Mohali & Chandigarh Adda';
      if (modalTitle) modalTitle.textContent = item.title || 'Karigar Adda Clip';

      var waMsg = 'Hello Meenu Label Mohali & Chandigarh Atelier! I loved the live karigar clip "' + (item.title || 'Bespoke Handwork') + '" (' + (item.category || 'Bespoke') + ') and would like to customize this handwork.';
      if (modalWaBtn) {
        modalWaBtn.href = 'https://wa.me/' + waNumber + '?text=' + encodeURIComponent(waMsg);
      }

      if (item.sources && item.sources.length > 0) {
        var videoEl = document.createElement('video');
        videoEl.controls = true;
        videoEl.autoplay = true;
        videoEl.playsInline = true;
        videoEl.loop = false;
        videoEl.muted = false;
        if (item.poster) videoEl.poster = item.poster;

        item.sources.forEach(function (src) {
          var s = document.createElement('source');
          s.src = src.url;
          if (src.type) s.type = src.type;
          videoEl.appendChild(s);
        });
        modalStage.appendChild(videoEl);

        if (modalMuteBtn) {
          modalMuteBtn.style.display = 'inline-block';
          modalMuteBtn.innerHTML = '&#128266; Sound On';
          modalMuteBtn.onclick = function () {
            videoEl.muted = !videoEl.muted;
            modalMuteBtn.innerHTML = videoEl.muted ? '&#128263; Muted' : '&#128266; Sound On';
          };
        }
        var p = videoEl.play();
        if (p && typeof p.catch === 'function') p.catch(function () {});
      } else {
        var imgEl = document.createElement('img');
        imgEl.src = item.poster || '';
        imgEl.alt = item.title || 'Mohali Adda preview';
        modalStage.appendChild(imgEl);

        var note = document.createElement('div');
        note.className = 'bespoke-modal-fallback-note';
        note.textContent = 'Adda preview frame \u2022 Tap WhatsApp below to request live video from our Mohali & Chandigarh karigars.';
        modalStage.appendChild(note);
      }
    }

    function openReelModal(clickedIdx) {
      currentVisibleIndices = [];
      reelCards.forEach(function (card) {
        if (!card.classList.contains('is-hidden-filter')) {
          currentVisibleIndices.push(parseInt(card.getAttribute('data-reel-index'), 10));
        }
      });
      if (!currentVisibleIndices.length) return;
      currentPos = Math.max(0, currentVisibleIndices.indexOf(clickedIdx));
      renderReelInModal(currentVisibleIndices[currentPos]);
      if (modal) {
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
      }
    }

    function closeReelModal() {
      unloadModalVideo();
      if (modal) modal.hidden = true;
      document.body.style.overflow = '';
    }

    reelCards.forEach(function (card) {
      card.addEventListener('click', function () {
        var idx = parseInt(card.getAttribute('data-reel-index'), 10);
        openReelModal(idx);
      });
    });

    if (modalPrev) {
      modalPrev.addEventListener('click', function () {
        if (!currentVisibleIndices.length) return;
        currentPos = (currentPos - 1 + currentVisibleIndices.length) % currentVisibleIndices.length;
        renderReelInModal(currentVisibleIndices[currentPos]);
      });
    }
    if (modalNext) {
      modalNext.addEventListener('click', function () {
        if (!currentVisibleIndices.length) return;
        currentPos = (currentPos + 1) % currentVisibleIndices.length;
        renderReelInModal(currentVisibleIndices[currentPos]);
      });
    }
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('[data-modal-close]')) {
          e.preventDefault();
          e.stopPropagation();
          closeReelModal();
        }
      });
    }
    document.addEventListener('keydown', function (e) {
      if (modal && !modal.hidden) {
        if (e.key === 'Escape') closeReelModal();
        if (e.key === 'ArrowLeft' && modalPrev) modalPrev.click();
        if (e.key === 'ArrowRight' && modalNext) modalNext.click();
      }
    });

    /* 3. Block D: Interactive Pure Silk & Custom Shade Selector */
    var selectedShade = 'Ivory Pearl';
    var selectedShadeColor = '#F4EFE6';
    var selectedFabric = 'Pure Chanderi Silk';
    var swatchBtns = root.querySelectorAll('[data-shade-name]');
    var fabricBtns = root.querySelectorAll('[data-fabric-name]');
    var shadeDot = document.getElementById('bespokeShadeDot-{{ section.id }}');
    var shadeText = document.getElementById('bespokeShadeText-{{ section.id }}');

    function updateShadeBanner() {
      if (shadeDot) shadeDot.style.background = selectedShadeColor;
      if (shadeText) {
        shadeText.innerHTML =
          'Selected: <strong>' + selectedShade + '</strong> &bull; Real daylight shade video sent on WhatsApp before adda work begins <span class="bespoke-fabric-echo">(Base: ' + selectedFabric + ')</span>';
      }
    }

    swatchBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectedShade = btn.getAttribute('data-shade-name') || 'Ivory Pearl';
        var circle = btn.querySelector('.bespoke-swatch-circle');
        selectedShadeColor = circle ? circle.style.background : '#F4EFE6';
        swatchBtns.forEach(function (b) {
          var isSel = b === btn;
          b.classList.toggle('is-selected', isSel);
          b.setAttribute('aria-checked', isSel ? 'true' : 'false');
        });
        updateShadeBanner();
      });
    });

    fabricBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectedFabric = btn.getAttribute('data-fabric-name') || 'Pure Chanderi Silk';
        fabricBtns.forEach(function (b) {
          var isSel = b === btn;
          b.classList.toggle('is-active', isSel);
          b.setAttribute('aria-checked', isSel ? 'true' : 'false');
        });
        updateShadeBanner();
      });
    });

    /* 4. Block E: Private Consultation Form -> Formatted WhatsApp Redirect */
    var form = document.getElementById('bespokeConsultForm-{{ section.id }}');
    var errBox = document.getElementById('bfError-{{ section.id }}');
    var okBox = document.getElementById('bfSuccess-{{ section.id }}');

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (errBox) errBox.style.display = 'none';
        if (okBox) okBox.style.display = 'none';

        var name = (document.getElementById('bfName-{{ section.id }}').value || '').trim();
        var phone = (document.getElementById('bfPhone-{{ section.id }}').value || '').trim();
        var cType = (document.getElementById('bfType-{{ section.id }}').value || '').trim();
        var oDate = (document.getElementById('bfDate-{{ section.id }}').value || '').trim();
        var budget = (document.getElementById('bfBudget-{{ section.id }}').value || '').trim();
        var notes = (document.getElementById('bfNotes-{{ section.id }}').value || '').trim();

        var phoneDigits = phone.replace(/\D/g, '');
        if (!name || phoneDigits.length < 10) {
          if (errBox) {
            errBox.textContent = 'Please enter your name and a valid 10-digit WhatsApp number so our Mohali & Chandigarh stylist can reach you.';
            errBox.style.display = 'block';
          }
          return;
        }

        var lines = [
          'Hello Meenu Label Mohali & Chandigarh Atelier! I would like to request a Private Bespoke Consultation:',
          '',
          '\u2022 Name: ' + name,
          '\u2022 WhatsApp Number: ' + phone,
          '\u2022 Commission Type: ' + cType,
          '\u2022 Occasion Date: ' + (oDate || 'Flexible / To be discussed'),
          '\u2022 Budget Bracket: ' + budget,
          '\u2022 Selected Shade & Fabric: ' + selectedShade + ' on ' + selectedFabric,
          '\u2022 Notes: ' + (notes || 'Looking forward to discussing embroidery & fit.')
        ];
        var waUrl = 'https://wa.me/' + waNumber + '?text=' + encodeURIComponent(lines.join('\n'));

        if (okBox) {
          okBox.innerHTML = '&#10003; Consultation brief ready! <a href="' + waUrl + '" target="_blank" rel="noopener noreferrer">Tap here if WhatsApp did not open automatically &rarr;</a>';
          okBox.style.display = 'block';
        }
        window.open(waUrl, '_blank', 'noopener');
      });
    }
  })();
</script>
