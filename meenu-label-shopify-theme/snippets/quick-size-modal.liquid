<!-- Snitch-Style Quick Size Drawer (Meenu Label) -->
<div class="snitch-size-backdrop" id="snitchSizeModalBackdrop" onclick="closeSnitchSizePopupOnBackdrop(event)">
  <div class="snitch-size-drawer" id="snitchSizeDrawer" role="dialog" aria-modal="true" aria-label="Choose Your Size">
    <!-- Header: CHOOSE YOUR SIZE + Wishlist Heart -->
    <div class="snitch-size-header">
      <span class="snitch-size-header-title">CHOOSE YOUR SIZE</span>
      <button type="button" class="snitch-size-wishlist-btn" id="snitchSizeWishlistBtn" onclick="toggleSnitchSizeWishlist(this)" title="Save to Wishlist" aria-label="Save to Wishlist">
        <svg class="snitch-heart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>
    </div>

    <!-- Size Rows List (Exact Snitch Stack) -->
    <div class="snitch-size-list" id="snitchSizeList">
      <!-- Dynamically generated rows: XS, S, M, L, XL, XXL -->
    </div>
  </div>
</div>
