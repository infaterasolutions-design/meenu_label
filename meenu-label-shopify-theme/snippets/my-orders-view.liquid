<script>
  function toggleOrderTrackingPanel(orderId) {
    var panel = document.getElementById('trackingPanel_' + orderId);
    var btn = document.getElementById('trackBtn_' + orderId);
    if (!panel) return;

    var isHidden = panel.style.display === 'none' || panel.style.display === '';
    panel.style.display = isHidden ? 'block' : 'none';

    if (btn) {
      var labelSpan = btn.querySelector('.track-btn-label');
      if (labelSpan) {
        labelSpan.textContent = isHidden ? 'HIDE TRACKING ▲' : 'TRACK SHIPMENT';
      }
      btn.style.background = isHidden ? '#9B7846' : '#1E1C19';
    }

    if (isHidden) {
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function filterOrderList(status, ev) {
    var pills = document.querySelectorAll('.order-filter-pill');
    pills.forEach(function(pill) {
      pill.style.background = '#FFFFFF';
      pill.style.color = '#4A4238';
      pill.style.borderColor = '#D6CEC3';
      pill.classList.remove('active');
    });
    if (ev && ev.target) {
      ev.target.style.background = '#1E1C19';
      ev.target.style.color = '#FFFFFF';
      ev.target.style.borderColor = '#1E1C19';
      ev.target.classList.add('active');
    }

    var cards = document.querySelectorAll('.luxury-order-card');
    cards.forEach(function(card) {
      if (status === 'all') {
        card.style.display = 'block';
      } else {
        var cardStatus = card.getAttribute('data-status') || '';
        if (cardStatus.indexOf(status) !== -1) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }
</script>
