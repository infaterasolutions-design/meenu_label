<div class="my-orders-page-section" style="background: #FAF8F5; min-height: 85vh; padding: 40px 20px 80px;">
  <div style="max-width: 980px; margin: 0 auto;">
    
    <!-- Breadcrumb -->
    <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #8C8275; margin-bottom: 24px;">
      <a href="/" style="color: inherit; text-decoration: none;">HOME</a> &nbsp;/&nbsp; 
      <a href="/pages/my-orders" style="color: inherit; text-decoration: none;">MY ACCOUNT</a> &nbsp;/&nbsp; 
      <span style="color: #1E1C19;">MY ORDERS</span>
    </div>

    <!-- Header Banner -->
    <div style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; padding: 28px 32px; margin-bottom: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.02);">
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
          <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; background: #FAF7F2; border: 1px solid #EAE3D9; color: #9B7846; padding: 3px 10px; border-radius: 4px;">
            &#10024; ATELIER CLIENT PORTAL
          </span>
          <span style="font-size: 11px; color: #8C8275; font-weight: 600;">Live Status &bull; 1-Click Tracking &bull; Doorstep Exchanges</span>
        </div>
        <h1 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 34px; font-weight: 600; color: #1E1C19; margin: 0 0 4px 0;">
          My Orders &amp; Purchases
        </h1>
        <div style="font-size: 13px; color: #6E6459;">
          Review all your handcrafted ensembles, live dispatch timelines, and cancellation records without typing any order ID.
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <a href="/collections/all" style="display: inline-block; padding: 10px 18px; background: #1E1C19; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
          EXPLORE DROP 01 &rarr;
        </a>
      </div>
    </div>

    <!-- Order Status Filter Pills (Flipkart/Myntra Style) -->
    <div style="display: flex; gap: 8px; margin-bottom: 24px; overflow-x: auto; padding-bottom: 4px;" class="orders-filter-bar">
      <button type="button" class="order-filter-pill active" onclick="filterOrderList('all', event)" style="padding: 8px 16px; border-radius: 20px; font-size: 11.5px; font-weight: 700; border: 1px solid #1E1C19; background: #1E1C19; color: #FFFFFF; cursor: pointer;">
        All Orders
      </button>
      <button type="button" class="order-filter-pill" onclick="filterOrderList('dispatched', event)" style="padding: 8px 16px; border-radius: 20px; font-size: 11.5px; font-weight: 600; border: 1px solid #D6CEC3; background: #FFFFFF; color: #4A4238; cursor: pointer;">
        Dispatched / In Transit
      </button>
      <button type="button" class="order-filter-pill" onclick="filterOrderList('delivered', event)" style="padding: 8px 16px; border-radius: 20px; font-size: 11.5px; font-weight: 600; border: 1px solid #D6CEC3; background: #FFFFFF; color: #4A4238; cursor: pointer;">
        Delivered
      </button>
      <button type="button" class="order-filter-pill" onclick="filterOrderList('canceled', event)" style="padding: 8px 16px; border-radius: 20px; font-size: 11.5px; font-weight: 600; border: 1px solid #D6CEC3; background: #FFFFFF; color: #4A4238; cursor: pointer;">
        Canceled
      </button>
    </div>

    <!-- ORDERS CONTAINER -->
    <div id="myOrdersListContainer" style="display: flex; flex-direction: column; gap: 20px;">

      <!-- LIQUID NATIVE ORDERS (When Customer is logged in to Shopify) -->
      {% if customer and customer.orders.size > 0 %}
        {% for order in customer.orders %}
          <div class="luxury-order-card" data-status="{% if order.cancelled %}canceled{% elsif order.fulfillment_status == 'fulfilled' %}delivered{% else %}dispatched{% endif %}" style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.02);">
            
            <!-- Card Header Bar (Amazon / Myntra Style) -->
            <div style="background: #FAF8F5; border-bottom: 1px solid #EAE5DE; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 12px;">
              <div style="display: flex; gap: 24px; flex-wrap: wrap;">
                <div>
                  <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275;">ORDER PLACED</div>
                  <div style="font-weight: 600; color: #1E1C19; margin-top: 2px;">{{ order.created_at | date: "%B %d, %Y" }}</div>
                </div>
                <div>
                  <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275;">TOTAL AMOUNT</div>
                  <div style="font-weight: 700; color: #1E1C19; margin-top: 2px;">{{ order.total_price | money }}</div>
                </div>
                <div>
                  <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275;">SHIP TO</div>
                  <div style="font-weight: 600; color: #1E1C19; margin-top: 2px;">{{ order.shipping_address.name | default: customer.name }}</div>
                </div>
              </div>

              <div>
                <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275; text-align: right;">ORDER NUMBER</div>
                <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 700; color: #1E1C19; margin-top: 1px;">{{ order.name }}</div>
              </div>
            </div>

            <!-- Card Body: Products & Status -->
            <div style="padding: 24px;">
              
              <!-- Status Heading -->
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; flex-wrap: wrap; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  {% if order.cancelled %}
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #DC2626;"></span>
                    <span style="font-size: 13.5px; font-weight: 700; color: #991B1B;">Canceled on {{ order.cancelled_at | date: "%B %d, %Y" }}</span>
                  {% elsif order.fulfillment_status == 'fulfilled' %}
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22C55E;"></span>
                    <span style="font-size: 13.5px; font-weight: 700; color: #15803D;">Delivered</span>
                  {% else %}
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #F59E0B;"></span>
                    <span style="font-size: 13.5px; font-weight: 700; color: #B45309;">Atelier Crafting &bull; Express Dispatch in Progress</span>
                  {% endif %}
                </div>

                <span style="font-size: 11px; color: #8C8275; font-weight: 600;">
                  Chandigarh Atelier &bull; Handcrafted Pure Silk
                </span>
              </div>

              <!-- Product Lines -->
              {% for line_item in order.line_items %}
                <div style="display: flex; gap: 18px; align-items: center; padding: 14px 0; border-top: 1px solid #F0EAE1; flex-wrap: wrap;">
                  {% if line_item.image %}
                    <img src="{{ line_item.image | image_url: width: 160 }}" alt="{{ line_item.title }}" style="width: 75px; height: 95px; object-fit: cover; border-radius: 6px; border: 1px solid #EAE5DE;">
                  {% endif %}

                  <div style="flex: 1; min-width: 200px;">
                    <a href="{{ line_item.url }}" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 19px; font-weight: 600; color: #1E1C19; text-decoration: none; display: block; line-height: 1.3;">
                      {{ line_item.title }}
                    </a>
                    {% if line_item.variant.title != 'Default Title' %}
                      <div style="font-size: 12px; color: #8C8275; margin-top: 3px;">
                        Size / Variant: <strong>{{ line_item.variant.title }}</strong>
                      </div>
                    {% endif %}
                    <div style="font-size: 13px; font-weight: 700; color: #1E1C19; margin-top: 4px;">
                      {{ line_item.final_price | money }} &bull; Qty: {{ line_item.quantity }}
                    </div>
                  </div>

                  <!-- Actions per item (Amazon/Flipkart Style) -->
                  <div style="display: flex; flex-direction: column; gap: 8px; min-width: 175px;">
                    <button type="button" onclick="toggleOrderTrackingPanel('{{ order.id }}')" id="trackBtn_{{ order.id }}" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 18px; background: #9E7D47; color: #FFFFFF; font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(158, 125, 71, 0.25);">
                      <span>&#128230;</span> <span class="track-btn-label">TRACK SHIPMENT</span>
                    </button>
                    <a href="{{ line_item.url }}" style="display: block; text-align: center; padding: 9px 14px; background: #FAF8F5; border: 1px solid #D6CEC3; color: #1E1C19; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
                      BUY IT AGAIN
                    </a>
                    <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20{{ line_item.title | url_encode }}%20from%20Order%20{{ order.name }}." target="_blank" style="display: block; text-align: center; padding: 6px 12px; color: #25D366; font-size: 10.5px; font-weight: 700; text-decoration: none;">
                      &#128172; WhatsApp Concierge
                    </a>
                  </div>
                </div>
              {% endfor %}

              <!-- EXPANDABLE PANEL (CANCELED VS ACTIVE) -->
              {% if order.cancelled %}
                <!-- CANCELLATION DETAILS PANEL -->
                <div id="trackingPanel_{{ order.id }}" style="display: none; margin-top: 20px; padding: 22px; background: #FFF5F5; border: 1px solid #FED7D7; border-radius: 8px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #FEB2B2; padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                    <div>
                      <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #991B1B;">✕ CANCELLATION &amp; REFUND STATUS</span>
                      <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #1E1C19;">
                        Order {{ order.name }} Details
                      </div>
                    </div>
                    <span style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 10.5px; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase;">
                      ✕ Order Canceled
                    </span>
                  </div>

                  <div style="background: #FFFFFF; border: 1px solid #FCA5A5; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; font-size: 12.5px; color: #7F1D1D; line-height: 1.5;">
                    <strong>Order Notice:</strong> This order was canceled on {{ order.cancelled_at | date: "%B %d, %Y" }}. Because the order was canceled, no courier shipment was dispatched.
                  </div>

                  <div class="shipment-timeline" style="margin: 16px 0 20px; padding-left: 26px;">
                    <div class="timeline-step completed">
                      <div class="timeline-title" style="color: #1E1C19;">Order Placed &amp; Confirmed</div>
                      <div class="timeline-desc" style="color: #6E6459;">{{ order.created_at | date: "%B %d, %Y at %I:%M %p" }}</div>
                    </div>
                    <div class="timeline-step canceled-step">
                      <div class="timeline-title" style="color: #991B1B; font-weight: 700;">Order Canceled</div>
                      <div class="timeline-desc" style="color: #7F1D1D;">Canceled on {{ order.cancelled_at | date: "%B %d, %Y" }}</div>
                    </div>
                    <div class="timeline-step completed">
                      <div class="timeline-title" style="color: #1E1C19;">Payment &amp; Refund Status</div>
                      <div class="timeline-desc" style="color: #2E6B38;">
                        {% if order.financial_status == 'refunded' %}
                          &#10003; 100% Refund Completed
                        {% else %}
                          &#10003; {{ order.financial_status | capitalize }} (No pending balance)
                        {% endif %}
                      </div>
                    </div>
                  </div>

                  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/collections/all" style="padding: 10px 18px; background: #1E1C19; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
                      RE-ORDER SILHOUETTE &rarr;
                    </a>
                    <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20my%20canceled%20Order%20{{ order.name }}." target="_blank" style="padding: 10px 18px; background: #25D366; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 6px;">
                      <span>&#128172;</span> Chat on WhatsApp
                    </a>
                  </div>
                </div>

              {% else %}
                <!-- ACTIVE SHIPMENT TIMELINE PANEL -->
                <div id="trackingPanel_{{ order.id }}" style="display: none; margin-top: 20px; padding: 22px; background: #FAF7F2; border: 1px solid #EAE3D9; border-radius: 8px;">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid #ECE4D8; padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                    <div>
                      <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #9B7846;">LIVE SHIPMENT TIMELINE</span>
                      <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #1E1C19;">
                        Order {{ order.name }} Status
                      </div>
                    </div>
                    <span style="background: #F3F8F2; border: 1px solid #D6E8D5; color: #2E6B38; font-size: 10.5px; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase;">
                      {% if order.fulfillment_status == 'fulfilled' %}&#10003; Delivered{% else %}&#9203; In Process{% endif %}
                    </span>
                  </div>

                  <div class="shipment-timeline" style="margin: 16px 0 20px; padding-left: 26px;">
                    <div class="timeline-step completed">
                      <div class="timeline-title" style="color: #1E1C19;">Order Confirmed &amp; Silk Reserved</div>
                      <div class="timeline-desc" style="color: #6E6459;">Chandigarh Studio Atelier &bull; Fabrics allocated</div>
                    </div>
                    <div class="timeline-step completed">
                      <div class="timeline-title" style="color: #1E1C19;">Handcrafted &amp; Master Quality Inspected</div>
                      <div class="timeline-desc" style="color: #6E6459;">Passed 14-point artisan luxury inspection</div>
                    </div>
                    <div class="timeline-step {% if order.fulfillment_status == 'fulfilled' %}completed{% else %}active{% endif %}">
                      <div class="timeline-title" style="color: #1E1C19;">Dispatched in Express Transit</div>
                      <div class="timeline-desc" style="color: #6E6459;">Express Courier Handover &bull; Tricity / National Air</div>
                    </div>
                    <div class="timeline-step {% if order.fulfillment_status == 'fulfilled' %}completed{% endif %}">
                      <div class="timeline-title" style="color: #1E1C19;">Out for Delivery &amp; VIP Handover</div>
                      <div class="timeline-desc" style="color: #6E6459;">Direct delivery to {{ order.shipping_address.name | default: 'Customer Destination' }}</div>
                    </div>
                  </div>

                  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20please%20share%20courier%20tracking%20update%20for%20Order%20{{ order.name }}." target="_blank" style="padding: 10px 18px; background: #25D366; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 6px;">
                      <span>&#128172;</span> Chat With Atelier Stylist
                    </a>
                    <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20need%20a%20doorstep%20size%20exchange%20for%20Order%20{{ order.name }}." target="_blank" style="padding: 10px 18px; background: #FFFFFF; border: 1px solid #D6CEC3; color: #1E1C19; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
                      &#128087; Request Doorstep Size Exchange
                    </a>
                  </div>
                </div>
              {% endif %}

            </div>
          </div>
        {% endfor %}
      {% endif %}

      <!-- CLIENT-SIDE EMBEDDED ORDERS (Flipkart / Myntra Style Past Orders) -->
      
      <!-- ORDER #1003 (White Porcelain Floral Tiered Dress) - CANCELED -->
      <div class="luxury-order-card" data-status="canceled" id="orderCard1003" style="background: #FFFFFF; border: 1px solid #EAE5DE; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px rgba(0,0,0,0.02);">
        
        <!-- Header Bar -->
        <div style="background: #FAF8F5; border-bottom: 1px solid #EAE5DE; padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: 12px;">
          <div style="display: flex; gap: 24px; flex-wrap: wrap;">
            <div>
              <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275;">ORDER PLACED</div>
              <div style="font-weight: 600; color: #1E1C19; margin-top: 2px;">November 08, 2026</div>
            </div>
            <div>
              <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275;">TOTAL AMOUNT</div>
              <div style="font-weight: 700; color: #1E1C19; margin-top: 2px;">&#8377;0.00 INR (Prepaid)</div>
            </div>
            <div>
              <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275;">SHIP TO</div>
              <div style="font-weight: 600; color: #1E1C19; margin-top: 2px;">Sandeep Singh</div>
            </div>
          </div>

          <div>
            <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8C8275; text-align: right;">ORDER NUMBER</div>
            <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 700; color: #1E1C19; margin-top: 1px;">#1003</div>
          </div>
        </div>

        <!-- Body -->
        <div style="padding: 24px;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #DC2626;"></span>
              <span style="font-size: 13.5px; font-weight: 700; color: #991B1B;">Canceled on November 12, 2026</span>
            </div>
            <span style="font-size: 11px; background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-weight: 700; padding: 2px 8px; border-radius: 4px;">
              CANCELED
            </span>
          </div>

          <div style="display: flex; gap: 18px; align-items: center; padding-top: 10px; flex-wrap: wrap;">
            <img src="https://cdn.shopify.com/s/files/1/0722/3325/4983/files/ElegantBlue-GreenFloralWrapDress.png?v=1793908108" onerror="this.onerror=null; this.src='{{ 'banner_everyday_dresses.jpg' | asset_url }}';" alt="The White Porcelain Floral Wrap Dress" style="width: 75px; height: 95px; object-fit: cover; border-radius: 6px; border: 1px solid #EAE5DE;">
            
            <div style="flex: 1; min-width: 200px;">
              <a href="/collections/dresses" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 600; color: #1E1C19; text-decoration: none; display: block; line-height: 1.3;">
                The White Porcelain Floral Wrap Dress
              </a>
              <div style="font-size: 12px; color: #8C8275; margin-top: 3px;">
                Size: <strong>M</strong> &bull; Pure Chanderi Silk Handcrafted Silhouette
              </div>
              <div style="font-size: 13px; font-weight: 700; color: #1E1C19; margin-top: 4px;">
                &#8377;1,599 &bull; Qty: 1
              </div>
            </div>

            <!-- Action Buttons on Card -->
            <div style="display: flex; flex-direction: column; gap: 8px; min-width: 185px;">
              <button type="button" onclick="toggleOrderTrackingPanel('1003')" id="trackBtn_1003" style="display: flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 18px; background: #9E7D47; color: #FFFFFF; font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; border: none; border-radius: 4px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(158, 125, 71, 0.25);">
                <span>&#128230;</span> <span class="track-btn-label">TRACK SHIPMENT</span>
              </button>
              <a href="/collections/dresses" style="display: block; text-align: center; padding: 9px 16px; background: #1E1C19; color: #FFFFFF; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">
                RE-ORDER THIS SILHOUETTE &rarr;
              </a>
              <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20canceled%20Order%20%231003." target="_blank" style="display: block; text-align: center; padding: 6px 12px; color: #25D366; font-size: 10.5px; font-weight: 700; text-decoration: none;">
                &#128172; WhatsApp Concierge
              </a>
            </div>
          </div>

          <!-- ACCURATE CANCELLATION & REFUND TIMELINE (NO FAKE DISPATCH!) -->
          <div id="trackingPanel_1003" style="display: none; margin-top: 20px; padding: 22px; background: #FFF5F5; border: 1px solid #FED7D7; border-radius: 8px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #FEB2B2; padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">
              <div>
                <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #991B1B;">✕ CANCELLATION &amp; REFUND RECORD</span>
                <div style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 700; color: #1E1C19;">
                  Order #1003 Status
                </div>
              </div>
              <span style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 10.5px; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase;">
                ✕ Canceled on Nov 12, 2026
