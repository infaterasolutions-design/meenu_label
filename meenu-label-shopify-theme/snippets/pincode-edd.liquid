<script>(function(){var K='meenu_pin',g=function(x){return document.getElementById(x)},i=g('eI'),w=g('eW'),r=g('eR');function ab(t,n){var d=new Date(t);while(n>0){d.setDate(d.getDate()+1);if(d.getDay())n--;}return d}function fm(d){var s=d.toDateString();return s.slice(0,3)+', '+s.slice(4,10).replace(' 0',' ')}window.mEddE=function(){w.style.display='flex';r.style.display='none';i.focus()};window.mEddC=function(a){var p=((typeof a==='string'?a:i.value)||'').trim();r.style.display='block';if(/^9\d{5}$/.test(p)){r.innerHTML='<b style="color:#6E1A24">Army/Special PIN detected — please <a href="https://wa.me/{{ settings.whatsapp_number | default: '918511616133' }}?text=APS%20PIN%20'+p+'" target="_blank">WhatsApp our Mohali Atelier Concierge</a> for courier confirmation.</b>';return}if(!/^[1-8]\d{5}$/.test(p)){r.innerHTML='<b style="color:#B91C1C">Please enter a valid 6-digit Indian PIN code (e.g. 160055).</b>';return}try{localStorage.setItem(K,p)}catch(e){}i.value=p;var n=new Date(),ist=new Date(+n+n.getTimezoneOffset()*6e4+198e5),hr=ist.getHours(),dp=new Date(ist.setHours(12,0,0,0));if(!dp.getDay()||hr>14)dp=ab(dp,1);var z=/^(160|140|134)/.test(p)?[1,2]:/^(1[89]|744|7[89])/.test(p)?[5,7]:/^(1[1-7]|201)/.test(p)?[2,3]:/^(400|411|560|500|600|700|380|302|226)/.test(p)?[3,4]:[4,5];w.style.display='none';r.innerHTML='<div id="eO"><span>✓ Delivers to PIN '+p+' by '+fm(ab(dp,z[0]))+' – '+fm(ab(dp,z[1]))+'</span><button type="button" id="eC" onclick="mEddE()">Change</button></div><div id="eS">• Free Priority Shipping &nbsp;• Cash on Delivery & UPI Available</div>'};try{var s=localStorage.getItem(K);if(/^[1-8]\d{5}$/.test(s))mEddC(s)}catch(e){}})();</script>