<div class="cart-backdrop" id="CartBackdrop" onclick="toggleCartDrawer()"></div>
<div class="cart-drawer" id="CartDrawer">
  <div class="cart-header">
    <h3 style="font-family: 'Cormorant Garamond', serif; font-size: 24px; margin: 0;">Your Shopping Bag (<span id="cartDrawerCount">{{ cart.item_count | default: 0 }}</span>)</h3>
    <button type="button" onclick="toggleCartDrawer()" style="background: none; border: none; font-size: 26px; cursor: pointer; color: var(--text-main); line-height: 1; padding: 4px;" aria-label="Close Bag">&times;</button>
  </div>

  <!-- Tiered Cart Goal Progress Bar (Flat ₹700 OFF at ₹4,999) -->
  {% assign cart_total = cart.total_price %}
  {% assign goal_threshold = 499900 %}
  {% assign is_goal_unlocked = false %}
  {% if cart_total >= goal_threshold %}
    {% assign is_goal_unlocked = true %}
  {% endif %}
  {% assign remaining_cents = goal_threshold | minus: cart_total %}
  {% if remaining_cents < 0 %}
    {% assign remaining_cents = 0 %}
  {% endif %}
  {% assign progress_pct = cart_total | times: 100.0 | divided_by: goal_threshold %}
  {% if progress_pct > 100 %}
    {% assign progress_pct = 100 %}
  {% endif %}

  <div class="cart-drawer-goal-wrap" id="cartDrawerGoalWrap" style="background: #FAF9F6; border: 1px solid #E8E4DE; border-radius: 10px; padding: 12px 16px; margin: 12px 16px 0 16px; box-sizing: border-box; {% if cart.item_count == 0 %}display:none;{% endif %}">
    <div id="cartDrawerGoalText" style="font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13.5px; color: #1C1B1A; text-align: center; line-height: 1.45; margin-bottom: 10px;">
      {% if is_goal_unlocked %}
        🎉 Congratulations! You have unlocked <strong>Flat &#8377;700 OFF</strong> on your order!
      {% else %}
        Add {{ remaining_cents | money }} more to unlock <strong>Flat &#8377;700 OFF</strong> on your order!
      {% endif %}
    </div>
    <!-- Progress Bar Track -->
    <div style="background: #EFECE6; height: 8px; border-radius: 10px; overflow: hidden; position: relative; width: 100%;">
      <div id="cartDrawerProgressBar" style="height: 100%; border-radius: 10px; width: {{ progress_pct }}%; transition: width 0.45s cubic-bezier(0.16, 1, 0.3, 1), background 0.35s ease, box-shadow 0.35s ease; {% if is_goal_unlocked %}background: #2E7D32; box-shadow: 0 0 10px rgba(46, 125, 50, 0.4);{% else %}background: linear-gradient(90deg, #D4AF37, #E5C158); box-shadow: none;{% endif %}"></div>
    </div>
  </div>

  <div class="cart-body" id="cartDrawerBody">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="cart-drawer-item" data-line-key="{{ item.key }}" style="display: flex; gap: 14px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border-color); align-items: center; position: relative;">
          <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" style="width: 72px; height: 90px; object-fit: cover; background: #FAF8F5; border-radius: 4px; padding: 2px; border: 1px solid rgba(0,0,0,0.06);">
          <div style="flex: 1; padding-right: 20px;">
            <div style="font-size: 13px; font-weight: 700; color: var(--text-main); line-height: 1.35;">{{ item.product.title }}</div>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Size: <strong>{{ item.variant.title }}</strong></div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px;">
              <div style="display: flex; align-items: center; border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden; background: #FAF8F5;">
                <button type="button" onclick="updateCartItemQty('{{ item.key }}', {{ item.quantity | minus: 1 }})" style="border: none; background: transparent; width: 26px; height: 26px; cursor: pointer; font-size: 14px; font-weight: 700; line-height: 1;">-</button>
                <span style="font-size: 12px; font-weight: 700; min-width: 26px; text-align: center;">{{ item.quantity }}</span>
                <button type="button" onclick="updateCartItemQty('{{ item.key }}', {{ item.quantity | plus: 1 }})" style="border: none; background: transparent; width: 26px; height: 26px; cursor: pointer; font-size: 14px; font-weight: 700; line-height: 1;">+</button>
              </div>
              <div style="font-size: 14px; font-weight: 700; color: var(--text-main);">{{ item.final_line_price | money }}</div>
            </div>
          </div>
          <button type="button" onclick="updateCartItemQty('{{ item.key }}', 0)" style="position: absolute; top: 2px; right: 0; background: none; border: none; font-size: 20px; color: #999; cursor: pointer; line-height: 1; padding: 4px;" title="Remove">&times;</button>
        </div>
      {% endfor %}
    {% else %}
      <div id="cartDrawerEmptyState" style="text-align: center; padding: 60px 20px; color: var(--text-muted);">
        <div style="font-size: 40px; margin-bottom: 12px; opacity: 0.7;">🛍️</div>
        <p style="font-size: 15px; margin-bottom: 6px; color: var(--text-main); font-weight: 700;">Your shopping bag is empty.</p>
        <p style="font-size: 12px; margin-bottom: 24px; color: var(--text-muted); line-height: 1.5;">Explore our Drop 01 handcrafted silhouettes and select your size.</p>
        <button type="button" class="modal-btn-primary" style="display: inline-block; width: auto; padding: 11px 26px;" onclick="toggleCartDrawer(); window.location.href='/collections/all';">EXPLORE DROP 01</button>
      </div>
    {% endif %}
  </div>

  <div class="cart-footer" id="cartDrawerFooter" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>
    <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 16px; margin-bottom: 10px;">
      <span>Subtotal</span>
      <span id="cartDrawerSubtotal">{{ cart.total_price | money }}</span>
    </div>

    <!-- Coupon Apply System in Drawer -->
    <div style="margin-bottom: 10px;">
      <div style="display: flex; gap: 6px;">
        <input type="text" id="cartDrawerCouponInput" placeholder="Enter coupon code" style="flex: 1; padding: 8px 10px; border: 1px solid var(--border-color); border-radius: 4px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; background: #FFF; outline: none; color: #1E1C19;">
        <button type="button" id="cartDrawerCouponBtn" onclick="applyCartDrawerCoupon()" style="padding: 8px 14px; background: #1E1C19; color: #FFF; border: none; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer; text-transform: uppercase;">APPLY</button>
      </div>
      <div style="display:flex; align-items:center; gap:6px; margin-top:6px;">
        <span style="font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.04em;">Available Offer:</span>
        <button type="button" onclick="quickApplyDrawerCoupon('FIRST500')" style="background:#FAF8F5; border:1px dashed #D4AF37; border-radius:12px; padding:2px 8px; font-size:10px; font-weight:700; color:#1E1C19; cursor:pointer; display:inline-flex; align-items:center; gap:3px;">
          <span>✨ FIRST500</span>
          <span style="color:#B48A28; font-size:9.5px;">(FLAT ₹500 OFF)</span>
        </button>
      </div>
      <div id="cartDrawerCouponFeedback" style="font-size: 11px; font-weight: 600; margin-top: 4px; display: none;"></div>
    </div>

    <div style="font-size: 11px; color: #166534; background: #EBF7EE; border: 1px solid #BBF7D0; padding: 6px 10px; border-radius: 4px; margin-bottom: 12px; text-align: center; font-weight: 600; line-height: 1.4;">
      ⚡ Pay via <strong>UPI</strong> at checkout to get <strong>Flat &#8377;100 Instant Discount</strong>
    </div>
    <form action="/cart" method="post" id="cartDrawerCheckoutForm" onsubmit="if(typeof window.showMeenuCheckoutTransition==='function') window.showMeenuCheckoutTransition();" style="margin: 0; padding: 0;">
      <input type="hidden" name="discount" id="cartDrawerDiscountInput" value="">
      <button type="submit" name="checkout" class="modal-btn-primary cart__checkout-button" style="width: 100%; text-align: center; display: block; box-sizing: border-box; text-decoration: none; border: none; cursor: pointer;">
        PROCEED TO CHECKOUT &rarr;
      </button>
    </form>
    <div style="font-size: 11px; color: var(--text-muted); text-align: center; margin-top: 10px;">
      🔒 256-Bit SSL Encrypted Checkout &bull; Free Pan-India Delivery
    </div>
  </div>
</div>

<script>
  function quickApplyDrawerCoupon(code) {
    var inp = document.getElementById('cartDrawerCouponInput');
    if (inp) inp.value = code;
    applyCartDrawerCoupon();
  }

  function applyCartDrawerCoupon() {
    var inp = document.getElementById('cartDrawerCouponInput');
    var feedback = document.getElementById('cartDrawerCouponFeedback');
    var btn = document.getElementById('cartDrawerCouponBtn');
    var discountInput = document.getElementById('cartDrawerDiscountInput');
    var code = inp ? inp.value.trim().toUpperCase() : '';

    if (!code) {
      if (feedback) {
        feedback.style.display = 'block';
        feedback.style.color = '#B91C1C';
        feedback.textContent = 'Please enter a coupon code';
      }
      return;
    }

    if (btn) btn.textContent = 'APPLIED';
    if (discountInput) discountInput.value = code;

    try {
      sessionStorage.setItem('meenu_applied_coupon', code);
    } catch(e) {}

    if (feedback) {
      feedback.style.display = 'block';
      feedback.style.color = '#15803D';
      feedback.innerHTML = '&#10003; Coupon <strong>' + code + '</strong> applied! Will be applied at checkout.';
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    try {
      var saved = sessionStorage.getItem('meenu_applied_coupon');
      if (saved === 'USEUPI100' || saved === 'UPI100') {
        sessionStorage.removeItem('meenu_applied_coupon');
        saved = null;
      }
      if (saved) {
        var inp = document.getElementById('cartDrawerCouponInput');
        if (inp) inp.value = saved;
        var btn = document.getElementById('cartDrawerCouponBtn');
        if (btn) btn.textContent = 'APPLIED';
        var discountInput = document.getElementById('cartDrawerDiscountInput');
        if (discountInput) discountInput.value = saved;
        var feedback = document.getElementById('cartDrawerCouponFeedback');
        if (feedback) {
          feedback.style.display = 'block';
          feedback.style.color = '#15803D';
          feedback.innerHTML = '&#10003; Coupon <strong>' + saved + '</strong> applied!';
        }
      }
    } catch(e) {}
  });
</script>
