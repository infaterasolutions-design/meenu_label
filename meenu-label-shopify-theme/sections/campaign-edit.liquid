    {
      "type": "text",
      "id": "card2_price",
      "label": "Card 2 Price",
      "default": "₹1,699"
    },
    {
      "type": "text",
      "id": "card2_mrp",
      "label": "Card 2 Compare MRP",
      "default": "₹2,799"
    },
    {
      "type": "header",
      "content": "Sub-Card 3 (Bottom Right)"
    },
    {
      "type": "product",
      "id": "card3_product",
      "label": "Card 3 Linked Product"
    },
    {
      "type": "image_picker",
      "id": "card3_image",
      "label": "Card 3 Custom Photo (Optional)"
    },
    {
      "type": "url",
      "id": "card3_url",
      "label": "Card 3 Link URL (Fallback)",
      "default": "/collections/dresses"
    },
    {
      "type": "text",
      "id": "card3_title",
      "label": "Card 3 Title",
      "default": "White Porcelain Floral Wrap Dress"
    },
    {
      "type": "text",
      "id": "card3_price",
