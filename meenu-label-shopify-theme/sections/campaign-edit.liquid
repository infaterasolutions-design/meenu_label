    {
      "type": "header",
      "content": "Sub-Card 2 (Top Right)"
    },
    {
      "type": "product",
      "id": "card2_product",
      "label": "Card 2 Linked Product"
    },
    {
      "type": "image_picker",
      "id": "card2_image",
      "label": "Card 2 Custom Photo (Optional)"
    },
    {
      "type": "url",
      "id": "card2_url",
      "label": "Card 2 Link URL (Fallback)",
      "default": "/collections/co-ord-sets"
    },
    {
      "type": "text",
      "id": "card2_title",
