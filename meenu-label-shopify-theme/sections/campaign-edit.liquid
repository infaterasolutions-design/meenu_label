<style>
  .campaign-grid {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 24px !important;
    align-items: stretch !important;
  }
  .campaign-sub-card {
    position: relative !important;
    border-radius: 18px !important;
    overflow: hidden !important;
    min-height: 480px !important;
    background: #0D0D0D !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-end !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06) !important;
    cursor: pointer !important;
  }
  .campaign-sub-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 25% !important;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .campaign-sub-card:hover .campaign-sub-img {
    transform: scale(1.04) !important;
  }
  .campaign-sub-vignette {
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      rgba(0, 0, 0, 0.75) 80%,
      rgba(0, 0, 0, 0.94) 100%
    ) !important;
  }
  .campaign-sub-content {
    position: relative !important;
    z-index: 2 !important;
    padding: 24px 26px !important;
  }
  .campaign-sub-name {
    font-family: 'Cormorant Garamond', Georgia, serif !important;
    font-size: 24px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin: 0 0 4px !important;
    line-height: 1.25 !important;
  }
  .campaign-sub-meta {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    margin-top: 12px !important;
  }
  .campaign-sub-price {
    font-size: 16px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
  }
  .btn-campaign-sub {
    background: #FFFFFF !important;
    color: #000000 !important;
    border: none !important;
    padding: 8px 16px !important;
    border-radius: 4px !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    cursor: pointer !important;
    text-decoration: none !important;
    transition: background 0.15s !important;
  }
  .btn-campaign-sub:hover {
    background: #EAEAEA !important;
  }

  @media (max-width: 900px) {
    .campaign-grid {
      grid-template-columns: 1fr !important;
      gap: 18px !important;
    }
    .campaign-sub-card {
      min-height: 380px !important;
    }
    .campaign-sub-content {
      padding: 20px 20px !important;
    }
  }
</style>

<section class="campaign-edit-section">
  <div class="campaign-header">
    <span class="campaign-eyebrow">{{ section.settings.eyebrow | default: 'Atelier Capsule 01 &bull; Editorial Lookbook' }}</span>
    <h2 class="campaign-title">
      {{ section.settings.heading | default: 'THE CAMPAIGN EDIT: EFFORTLESS CHANDIGARH MORNINGS TO <span class="accent">REGAL EVENINGS</span>' }}
    </h2>
    <p class="campaign-sub">{{ section.settings.subheading | default: "Curated silhouettes styled in natural daylight across Chandigarh's iconic verandahs and promenades." }}</p>
  </div>

  {%- comment -%} Determine safe functional links with zero 404s {%- endcomment -%}
  {%- assign card1_url = section.settings.card1_url -%}
  {%- if section.settings.card1_product != blank -%}
    {%- assign card1_url = section.settings.card1_product.url -%}
  {%- endif -%}
  {%- if card1_url == blank or card1_url == '#' or card1_url contains 'jaipur-chanderi-silk-festive-suit' or card1_url == '/collections/all' -%}
    {%- assign card1_url = '/products/the-royal-wine-chanderi-festive-suit' -%}
  {%- endif -%}

  {%- assign card1_title = section.settings.card1_title -%}
  {%- if card1_title == blank or card1_title == 'Jaipur Chanderi Silk Festive Suit' -%}
    {%- assign card1_title = 'The Royal Wine Chanderi Festive Suit' -%}
  {%- endif -%}

  {%- assign card2_url = section.settings.card2_url -%}
  {%- if section.settings.card2_product != blank -%}
    {%- assign card2_url = section.settings.card2_product.url -%}
  {%- endif -%}
  {%- if card2_url == blank or card2_url == '#' -%}
    {%- assign card2_url = '/collections/co-ord-sets' -%}
  {%- endif -%}

  {%- assign card2_title = section.settings.card2_title | default: 'Mustard Crepe Angrakha Co-ord' -%}

  {%- assign card3_url = section.settings.card3_url -%}
  {%- if section.settings.card3_product != blank -%}
    {%- assign card3_url = section.settings.card3_product.url -%}
  {%- endif -%}
  {%- if card3_url == blank or card3_url == '#' -%}
    {%- assign card3_url = '/collections/dresses' -%}
  {%- endif -%}

  {%- assign card3_title = section.settings.card3_title | default: 'White Porcelain Floral Wrap Dress' -%}

  <div class="campaign-grid">
    <!-- Card 1: The Royal Wine Chanderi Festive Suit -->
    <div class="campaign-sub-card" onclick="window.location.href='{{ card1_url }}'">
      {%- if section.settings.card1_image != blank -%}
        <img src="{{ section.settings.card1_image | img_url: '900x' }}" alt="{{ card1_title | escape }}" class="campaign-sub-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'campaign_cafe.jpg' | asset_url }}" alt="{{ card1_title | escape }}" class="campaign-sub-img" loading="lazy">
      {%- endif -%}
      <div class="campaign-sub-vignette"></div>
      <div class="campaign-sub-content">
        <h4 class="campaign-sub-name">{{ card1_title }}</h4>
        <p style="font-size:12px; color:rgba(255,255,255,0.75); margin:0 0 8px;">{{ section.settings.card1_subtitle | default: 'Handcrafted Chanderi &amp; Zari Trim' }}</p>
        <div class="campaign-sub-meta" onclick="event.stopPropagation()">
          <div>
            <span class="campaign-sub-price">{{ section.settings.card1_price | default: '&#8377;2,299' }}</span>
            <span style="font-size:11px; color:rgba(255,255,255,0.5); text-decoration:line-through; margin-left:6px;">{{ section.settings.card1_mrp | default: '&#8377;3,699' }}</span>
          </div>
          <a href="{{ card1_url }}" class="btn-campaign-sub">
            <span>SHOP LOOK</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 2: Mustard Crepe Angrakha Co-ord -->
    <div class="campaign-sub-card" onclick="window.location.href='{{ card2_url }}'">
      {%- if section.settings.card2_image != blank -%}
        <img src="{{ section.settings.card2_image | img_url: '900x' }}" alt="{{ card2_title | escape }}" class="campaign-sub-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'campaign_sukhna.jpg' | asset_url }}" alt="{{ card2_title | escape }}" class="campaign-sub-img" loading="lazy">
      {%- endif -%}
      <div class="campaign-sub-vignette"></div>
      <div class="campaign-sub-content">
        <h4 class="campaign-sub-name">{{ card2_title }}</h4>
        <p style="font-size:12px; color:rgba(255,255,255,0.75); margin:0 0 8px;">{{ section.settings.card2_subtitle | default: 'Gold Gota Trim with Side Tie-Up Tassels' }}</p>
        <div class="campaign-sub-meta" onclick="event.stopPropagation()">
          <div>
            <span class="campaign-sub-price">{{ section.settings.card2_price | default: '&#8377;1,699' }}</span>
            <span style="font-size:11px; color:rgba(255,255,255,0.5); text-decoration:line-through; margin-left:6px;">{{ section.settings.card2_mrp | default: '&#8377;2,799' }}</span>
          </div>
          <a href="{{ card2_url }}" class="btn-campaign-sub">
            <span>SHOP LOOK</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Card 3: White Porcelain Floral Wrap Dress -->
    <div class="campaign-sub-card" onclick="window.location.href='{{ card3_url }}'">
      {%- if section.settings.card3_image != blank -%}
        <img src="{{ section.settings.card3_image | img_url: '900x' }}" alt="{{ card3_title | escape }}" class="campaign-sub-img" loading="lazy">
      {%- else -%}
        <img src="{{ 'campaign_balcony.jpg' | asset_url }}" alt="{{ card3_title | escape }}" class="campaign-sub-img" loading="lazy">
      {%- endif -%}
      <div class="campaign-sub-vignette"></div>
      <div class="campaign-sub-content">
        <h4 class="campaign-sub-name">{{ card3_title }}</h4>
        <p style="font-size:12px; color:rgba(255,255,255,0.75); margin:0 0 8px;">{{ section.settings.card3_subtitle | default: 'Featherlight Georgette with Circular Waist Belt' }}</p>
        <div class="campaign-sub-meta" onclick="event.stopPropagation()">
          <div>
            <span class="campaign-sub-price">{{ section.settings.card3_price | default: '&#8377;1,599' }}</span>
            <span style="font-size:11px; color:rgba(255,255,255,0.5); text-decoration:line-through; margin-left:6px;">{{ section.settings.card3_mrp | default: '&#8377;2,599' }}</span>
          </div>
          <a href="{{ card3_url }}" class="btn-campaign-sub">
            <span>SHOP LOOK</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

