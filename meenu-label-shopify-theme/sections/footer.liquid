<footer>
  <div class="footer-inner">
    <div class="footer-col">
      <img src="{{ 'logo.png' | asset_url }}" alt="Meenu Label" style="height: 48px; width: auto; filter: invert(1); display: block; margin-bottom: 16px;">
      <p>Contemporary Indian ethnic wear and modern fusion silhouettes. Handcrafted elegance for everyday grace.</p>
      <p style="font-size: 11px; color: #82786D; margin-top: 12px; line-height: 1.6;">
        <strong>Meenu Label &bull; Independent Luxury Label</strong><br>
        Chandigarh, India &bull; Official Store: <strong>meenulabel.com</strong>
      </p>
    </div>

    <div class="footer-col">
      <h4>Collection</h4>
      <ul>
        <li><a href="/collections/all">All Drop 01 Items</a></li>
        <li><a href="/collections/co-ord-sets">Co-ord Sets</a></li>
        <li><a href="/collections/festive-suits">Festive Suits</a></li>
        <li><a href="/collections/dresses">Midi Dresses</a></li>
        <li><a href="/collections/tops">Casual Tops</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Client Care</h4>
      <ul>
        <li><a href="javascript:void(0)" onclick="openPolicyModal('about')">About Us (Our Story)</a></li>
        <li><a href="javascript:void(0)" onclick="openPolicyModal('shipping')">Shipping &amp; Delivery Policy</a></li>
        <li><a href="javascript:void(0)" onclick="openPolicyModal('exchange')">7-Day Exchange &amp; Returns</a></li>
        <li><a href="javascript:void(0)" onclick="openPolicyModal('privacy')">Privacy Policy &amp; Terms</a></li>
        <li><a href="javascript:void(0)" onclick="openPolicyModal('contact')">Contact &amp; Grievance Redressal</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Newsletter</h4>
      <p>Receive exclusive early access to Drop 02 and private founder trunk shows.</p>
      <div style="display: flex; gap: 8px; margin-top: 12px;">
        <input type="email" placeholder="Enter your email..." style="padding: 10px 14px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.08); color: #FFF; font-size: 13px; flex: 1;">
        <button type="button" class="modal-btn-primary" style="padding: 10px 18px; width:auto; margin:0;" onclick="alert('Thank you for subscribing to Meenu Label!')">JOIN</button>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div>&copy; {{ 'now' | date: '%Y' }} Meenu Label (Sole Proprietorship). All rights reserved.</div>
    <div>&#128274; 256-Bit SSL Encrypted &bull; Shopify Online Store 2.0 &bull; Chandigarh, India</div>
  </div>
</footer>

