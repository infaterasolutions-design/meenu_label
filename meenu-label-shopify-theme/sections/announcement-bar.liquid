<div class="announcement-bar">
  <!-- Desktop Layout: 3-column side-by-side -->
  <div class="ann-desktop-row">
    <div class="ann-left">
      <span>&#9889; BLACK FRIDAY SALE LIVE &bull; MOHALI ATELIER</span>
    </div>
    <div class="ann-center" id="annDesktopCenter" style="position:relative; height:24px; min-width:340px; display:flex; align-items:center; justify-content:center;">
      <!-- Desktop Item 1: Black Friday BF25 Hero Offer -->
      <div class="ann-desk-item active" onclick="applyGlobalCoupon('BF25')" style="cursor:pointer;" title="Click to apply Black Friday 25% OFF">
        <div class="upi-ann-badge">
          <span style="font-size:12px; margin-right:3px;">✨</span>
          <span>BLACK FRIDAY SALE &bull; FLAT 25% OFF</span>
          <span class="upi-code-pill">CODE: BF25</span>
        </div>
      </div>
      <!-- Desktop Item 2: Limited Time Black Friday Highlight -->
      <div class="ann-desk-item" onclick="applyGlobalCoupon('BF25')" style="cursor:pointer;" title="Click to apply code BF25">
        <div class="upi-ann-badge">
          <span style="font-size:12px; margin-right:3px;">⏳</span>
          <span>LIMITED TIME (NOV 27 &ndash; 30) &bull; USE</span>
          <span class="upi-code-pill">BF25</span>
        </div>
      </div>
    </div>
    <div class="ann-right">
      <span>FREE PAN-INDIA EXPRESS SHIPPING</span>
      <a href="javascript:void(0)" onclick="openSizeGuideModal()">SIZE GUIDE</a>
    </div>
  </div>

  <!-- Mobile Auto-Slider Ticker: Cycles smoothly between key updates -->
  <div class="ann-mobile-ticker" id="annMobileTicker">
    <!-- Item 1: Black Friday BF25 Discount -->
    <div class="ticker-item active" onclick="applyGlobalCoupon('BF25')" style="cursor:pointer;" title="Click to apply Black Friday 25% OFF">
      <div class="upi-ann-badge" style="margin: 0 auto;">
        <span style="font-size:11px; margin-right:3px;">✨</span>
        <span>BLACK FRIDAY: FLAT 25% OFF &bull; CODE:</span>
        <span class="upi-code-pill">BF25</span>
      </div>
    </div>

    <!-- Item 2: Limited Time Nov 27-30 -->
    <div class="ticker-item" onclick="applyGlobalCoupon('BF25')" style="cursor:pointer;" title="Click to apply code BF25">
      <div class="upi-ann-badge" style="margin: 0 auto;">
        <span style="font-size:11px; margin-right:3px;">⏳</span>
        <span>LIMITED TIME (NOV 27&ndash;30) &bull; CODE:</span>
        <span class="upi-code-pill">BF25</span>
      </div>
    </div>

    <!-- Item 3: Mohali Atelier Dispatch -->
    <div class="ticker-item">
      <span>&#9889; READY STOCK &bull; DISPATCHES IN 24 HRS FROM MOHALI</span>
    </div>

    <!-- Item 4: Free Pan-India Shipping -->
    <div class="ticker-item">
      <span>&#9992;&#65039; FREE PAN-INDIA EXPRESS DELIVERY &bull; COD &amp; UPI</span>
    </div>

    <!-- Item 5: Size & 7-Day Exchange -->
    <div class="ticker-item" onclick="openSizeGuideModal()" style="cursor: pointer;">
      <span>&#128207; TRUE TO SIZE &bull; 7-DAY EASY SIZE EXCHANGE</span>
    </div>
  </div>
</div>

<style>
  .ann-desktop-row {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }
  .ann-desk-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }
  .ann-desk-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .ann-mobile-ticker {
    display: none;
    width: 100%;
    text-align: center;
    position: relative;
    height: 28px;
    overflow: hidden;
  }
  .ann-mobile-ticker .ticker-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    font-weight: 600;
  }
  .ann-mobile-ticker .ticker-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (max-width: 991px) {
    .ann-desktop-row {
      display: none !important;
    }
    .ann-mobile-ticker {
      display: flex !important;
      align-items: center;
      justify-content: center;
    }
    .announcement-bar {
      padding: 6px 12px !important;
      justify-content: center !important;
    }
  }
</style>

<script>
  window.applyGlobalCoupon = window.applyGlobalCoupon || function(code) {
    if (!code) return;
    code = code.trim().toUpperCase();
    try {
      sessionStorage.setItem('meenu_applied_coupon', code);
      if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(code).catch(function() {});
      }
    } catch(e) {}
    if (typeof showMeenuToast === 'function') {
      showMeenuToast('✓ Code "' + code + '" applied! Live savings active in bag.');
    } else {
      alert('✓ Code "' + code + '" applied! Live savings active in bag.');
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    // Desktop center ticker rotation
    var deskItems = document.querySelectorAll('#annDesktopCenter .ann-desk-item');
    if (deskItems && deskItems.length > 1) {
      var deskIdx = 0;
      setInterval(function() {
        deskItems[deskIdx].classList.remove('active');
        deskIdx = (deskIdx + 1) % deskItems.length;
        deskItems[deskIdx].classList.add('active');
      }, 3500);
    }

    // Mobile ticker rotation
    var items = document.querySelectorAll('#annMobileTicker .ticker-item');
    if (!items || items.length < 2) return;
    var currentIndex = 0;
    setInterval(function() {
      items[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % items.length;
      items[currentIndex].classList.add('active');
    }, 3200);
  });
</script>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
