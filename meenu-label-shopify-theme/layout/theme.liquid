<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF8F5">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>{{ page_title }} &bull; {{ shop.name }}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google tag (gtag.js) - Google Analytics 4 -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2WG6R9VLDQ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2WG6R9VLDQ');
    </script>

    <!-- High-Speed CDN & Payment Gateway Preconnections -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    <link rel="preconnect" href="https://api.razorpay.com" crossorigin>
    <link rel="preconnect" href="https://checkout.razorpay.com" crossorigin>
    <link rel="dns-prefetch" href="https://api.razorpay.com">
    <link rel="dns-prefetch" href="https://checkout.razorpay.com">
    <link rel="dns-prefetch" href="https://connect.facebook.net">
    <!-- Background Prefetch of Razorpay Core Bundle for Instant Checkout -->
    <link rel="prefetch" href="https://checkout.razorpay.com/v1/checkout.js" as="script">

    {% if template.name == 'index' %}
      <!-- LCP Hero Image Preload (High-Priority Mobile & Desktop) -->
      <link rel="preload" as="image" href="{{ 'banner_black_friday_mob.jpg' | asset_url }}" media="(max-width: 768px)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ 'banner_black_friday.jpg' | asset_url }}" media="(min-width: 769px)" fetchpriority="high">
    {% endif %}

    <!-- Optimized Non-Blocking Google Fonts -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    </noscript>

    {{ 'meenu-luxury.css' | asset_url | stylesheet_tag }}

    <script>
      // 1. Seamless redirect from legacy product slug to official product URL
      if (window.location.pathname.indexOf('jaipur-chanderi-silk-festive-suit') !== -1) {
        window.location.replace('/products/the-royal-wine-chanderi-festive-suit');
      }
      // 2. Seamless instant redirects to official published Shopify policy URLs
      var _path = window.location.pathname.toLowerCase();
      if (_path.indexOf('/pages/returns-exchanges') !== -1 || _path.indexOf('/pages/refund-policy') !== -1 || _path.indexOf('/pages/return-policy') !== -1) {
        window.location.replace('/policies/refund-policy');
      } else if (_path.indexOf('/pages/shipping-delivery') !== -1 || _path.indexOf('/pages/shipping-policy') !== -1) {
        window.location.replace('/policies/shipping-policy');
      } else if (_path.indexOf('/pages/terms-of-service') !== -1 || _path.indexOf('/pages/terms') !== -1) {
        window.location.replace('/policies/terms-of-service');
      } else if (_path.indexOf('/pages/contact') !== -1) {
        window.location.replace('/policies/contact-information');
      }
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    {% section 'announcement-bar' %}

    <div class="site-sticky-header-container" id="siteStickyHeaderContainer">
      {% section 'header' %}
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'nav-drawer' %}
    {% render 'wishlist-drawer' %}
    {% render 'size-guide-modal' %}
    {% render 'quick-size-modal' %}
  {% render 'notify-me-modal' %}
    {% render 'policy-modal' %}
    {% render 'whatsapp-concierge' %}
    {% render 'snitch-login-modal' %}

    <!-- Atelier Instant Checkout Transition Overlay & Double-Click Shield -->
    <div id="meenuCheckoutTransition" style="display:none; position:fixed; inset:0; z-index:999999; background:rgba(26,24,22,0.88); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); align-items:center; justify-content:center; flex-direction:column; text-align:center; color:#FAF8F5; font-family:'Plus Jakarta Sans',sans-serif; padding:24px;">
      <div style="width:48px; height:48px; border:3px solid rgba(212,175,55,0.2); border-top-color:#D4AF37; border-radius:50%; animation:meenuSpin 0.75s cubic-bezier(0.68,-0.55,0.27,1.55) infinite; margin-bottom:18px;"></div>
      <div style="font-family:'Cormorant Garamond',serif; font-size:24px; font-weight:600; letter-spacing:0.04em; margin-bottom:8px; color:#FFFFFF;">Securing Atelier Checkout</div>
      <div style="font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#D4AF37; font-weight:500;">Connecting Express 1-Page Gateway &bull; UPI &bull; COD</div>
    </div>
    <style>
      @keyframes meenuSpin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
    </style>

    <script src="{{ 'meenu-theme.js' | asset_url }}" defer="defer"></script>

    <script>
      // Global Instant Checkout Transition Handler
      window.showMeenuCheckoutTransition = function() {
        var el = document.getElementById('meenuCheckoutTransition');
        if (el) el.style.display = 'flex';
      };

      // Cross-Device Shopify 1-Page Checkout & Payment Bundle Preloader
      (function() {
        function prefetchCheckoutBundle() {
          var coreCheckoutAssets = [
            '/cdn/shopifycloud/checkout-web/assets/c1/polyfills.BmwiweTg.js',
            '/cdn/shopifycloud/checkout-web/assets/c1/app.ARMkEK2u.js',
            '/cdn/shopifycloud/checkout-web/assets/c1/630ba094.Cz6IQlUg.js',
            '/cdn/shopifycloud/checkout-web/assets/c1/4509beb0.Mtk3A2Tn.js',
            '/cdn/shopifycloud/checkout-web/assets/c1/6ec9a0fa.IGk8g30z.js',
            '/cdn/shopifycloud/checkout-web/assets/c1/f025431a.BlsbPO0-.js',
            '/cdn/shopifycloud/checkout-web/assets/c1/assets/app.CGRs8DQS.css',
            '/cdn/shopifycloud/checkout-web/assets/c1/assets/OnePage.mSY95ESL.css',
            '/cdn/shopifycloud/checkout-web/assets/c1/assets/deferred-boot.DGZtCWKG.css',
            'https://cdn.shopify.com/s/files/1/0722/3325/4983/files/meenu_logo_official_x320.png',
            'https://checkout.razorpay.com/v1/checkout.js',
            'https://connect.facebook.net/en_US/fbevents.js'
          ];
          coreCheckoutAssets.forEach(function(src) {
            var l = document.createElement('link');
            l.rel = 'prefetch';
            l.href = src;
            l.as = src.endsWith('.css') ? 'style' : (src.endsWith('.png') ? 'image' : 'script');
            l.crossOrigin = '';
            document.head.appendChild(l);
          });
        }

        if (window.requestIdleCallback) {
          window.requestIdleCallback(function() { setTimeout(prefetchCheckoutBundle, 600); });
        } else {
          setTimeout(prefetchCheckoutBundle, 1000);
        }
      })();
    </script>

    <script>
      // Non-blocking patron wishlist & cart cleanup on logout
      document.addEventListener('DOMContentLoaded', function() {
        {% if customer %}
          try {
            var customerId = '{{ customer.id }}';
            localStorage.setItem('meenu_active_patron', customerId);
            var archivedWishlist = localStorage.getItem('meenu_wishlist_archive_' + customerId);
            var currentWishlist = localStorage.getItem('meenu_saved_wishlist');
            if (archivedWishlist && (!currentWishlist || currentWishlist === '{}' || currentWishlist === '[]')) {
              localStorage.setItem('meenu_saved_wishlist', archivedWishlist);
              if (typeof updateWishlistUI === 'function') updateWishlistUI();
            }
          } catch(e) {}
        {% else %}
          try {
            var prevPatron = localStorage.getItem('meenu_active_patron');
            if (prevPatron) {
              var currentWishlist = localStorage.getItem('meenu_saved_wishlist');
              if (currentWishlist) {
                localStorage.setItem('meenu_wishlist_archive_' + prevPatron, currentWishlist);
              }
              localStorage.removeItem('meenu_saved_wishlist');
              localStorage.removeItem('meenu_active_patron');
              localStorage.removeItem('meenu_customer_email');
              sessionStorage.clear();
              if (typeof updateWishlistUI === 'function') updateWishlistUI();

              fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                .then(function() {
                  if (window.location.pathname.indexOf('/cart') !== -1) {
                    window.location.reload();
                  } else {
                    var headerBadge = document.getElementById('headerCartCount');
                    if (headerBadge) { headerBadge.textContent = '0'; headerBadge.style.display = 'none'; }
                    var navBadges = document.querySelectorAll('.nav-drawer-cart-count');
                    navBadges.forEach(function(b) { b.textContent = '0'; b.style.display = 'none'; });
                  }
                })
                .catch(function(err) { console.log('Cart logout clear notice:', err); });
            }
          } catch(e) {}
        {% endif %}
      });

      // Ultra-fast mobile link prefetcher on touchstart
      (function() {
        var prefetched = {};
        document.addEventListener('touchstart', function(e) {
          var a = e.target.closest('a');
          if (a && a.href && a.origin === window.location.origin) {
            var url = a.pathname;
            if (!prefetched[url] && !url.startsWith('/account') && !url.startsWith('/cart/clear')) {
              prefetched[url] = true;
              var link = document.createElement('link');
              link.rel = 'prefetch';
              link.href = a.href;
              document.head.appendChild(link);
            }
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>
