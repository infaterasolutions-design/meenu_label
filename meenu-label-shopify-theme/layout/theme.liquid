<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FAF8F5">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>{{ page_title }} &bull; {{ shop.name }}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {% if template.name == 'index' %}
      <!-- LCP Hero Image Preload (High-Priority Mobile & Desktop) -->
      <link rel="preload" as="image" href="{{ 'banner_modern_ethnic_mob.jpg' | asset_url }}" media="(max-width: 768px)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ 'banner_modern_ethnic.jpg' | asset_url }}" media="(min-width: 769px)" fetchpriority="high">
    {% endif %}

    <!-- Optimized Non-Blocking Google Fonts -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    </noscript>

    {{ 'meenu-luxury.css' | asset_url | stylesheet_tag }}

    <script>
      // 1. Seamless redirect from legacy product slug to official product URL
      if (window.location.pathname.indexOf('jaipur-chanderi-silk-festive-suit') !== -1) {
        window.location.replace('/products/the-royal-wine-chanderi-festive-suit');
      }
      // 2. Seamless instant redirects to official published Shopify policy URLs
      var _path = window.location.pathname.toLowerCase();
      if (_path.indexOf('/pages/returns-exchanges') !== -1 || _path.indexOf('/pages/refund-policy') !== -1 || _path.indexOf('/pages/return-policy') !== -1) {
        window.location.replace('/policies/refund-policy');
      } else if (_path.indexOf('/pages/shipping-delivery') !== -1 || _path.indexOf('/pages/shipping-policy') !== -1) {
        window.location.replace('/policies/shipping-policy');
      } else if (_path.indexOf('/pages/terms-of-service') !== -1 || _path.indexOf('/pages/terms') !== -1) {
        window.location.replace('/policies/terms-of-service');
      } else if (_path.indexOf('/pages/contact') !== -1) {
        window.location.replace('/policies/contact-information');
      }
    </script>

    <script>
      // Post-logout & login safety net: sync and clear residual cart & wishlist
      (function() {
        {% if customer %}
          try {
            var customerId = '{{ customer.id }}';
            localStorage.setItem('meenu_active_patron', customerId);
            // Restore archived wishlist for this patron if currently empty
            var archivedWishlist = localStorage.getItem('meenu_wishlist_archive_' + customerId);
            var currentWishlist = localStorage.getItem('meenu_saved_wishlist');
            if (archivedWishlist && (!currentWishlist || currentWishlist === '{}' || currentWishlist === '[]')) {
              localStorage.setItem('meenu_saved_wishlist', archivedWishlist);
              if (typeof updateWishlistUI === 'function') updateWishlistUI();
            }
          } catch(e) {}
        {% else %}
          try {
            var prevPatron = localStorage.getItem('meenu_active_patron');
            if (prevPatron) {
              // Archive patron wishlist before clearing
              var currentWishlist = localStorage.getItem('meenu_saved_wishlist');
              if (currentWishlist) {
                localStorage.setItem('meenu_wishlist_archive_' + prevPatron, currentWishlist);
              }
              // Wipe guest wishlist & tokens
              localStorage.removeItem('meenu_saved_wishlist');
              localStorage.removeItem('meenu_active_patron');
              localStorage.removeItem('meenu_customer_email');
              sessionStorage.clear();
              if (typeof updateWishlistUI === 'function') updateWishlistUI();

              // Clear cart on backend & refresh
              fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                .then(function() {
                  if (window.location.pathname.indexOf('/cart') !== -1) {
                    window.location.reload();
                  } else {
                    var headerBadge = document.getElementById('headerCartCount');
                    if (headerBadge) { headerBadge.textContent = '0'; headerBadge.style.display = 'none'; }
                    var navBadges = document.querySelectorAll('.nav-drawer-cart-count');
                    navBadges.forEach(function(b) { b.textContent = '0'; b.style.display = 'none'; });
                  }
                })
                .catch(function(err) { console.log('Cart logout clear notice:', err); });
            }
          } catch(e) {}
        {% endif %}
      })();
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    {% section 'announcement-bar' %}

    <div class="site-sticky-header-container" id="siteStickyHeaderContainer">
      {% section 'header' %}
    </div>

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'nav-drawer' %}
    {% render 'wishlist-drawer' %}
    {% render 'size-guide-modal' %}
    {% render 'quick-size-modal' %}
  {% render 'notify-me-modal' %}
    {% render 'policy-modal' %}
    {% render 'whatsapp-concierge' %}
    {% render 'snitch-login-modal' %}

    <script src="{{ 'meenu-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
