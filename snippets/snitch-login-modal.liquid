<div class="snitch-login-backdrop" id="accountModalBackdrop" onclick="closeAccountModal(event)">
  <div class="snitch-login-dialog" onclick="event.stopPropagation()">
    <!-- Top Action Buttons -->
    <button class="snitch-dialog-back" onclick="closeAccountModalDirect()" title="Back to Store" aria-label="Back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="snitch-dialog-close" onclick="closeAccountModalDirect()" title="Close" aria-label="Close">&times;</button>

    <!-- Left Column: Editorial Campaign Photo -->
    <div class="snitch-login-campaign">
      <img src="{{ 'hero_slide_2.jpg' | asset_url }}" alt="{{ shop.name }}" class="snitch-campaign-photo">
      <div class="snitch-campaign-vignette"></div>
      <div class="snitch-campaign-text">
        <div class="snitch-campaign-pill">Signature Silhouettes</div>
        <h2 class="snitch-campaign-headline">
          WEAR WHAT'S <span class="snitch-headline-accent">TIMELESS</span>
        </h2>
        <p class="snitch-campaign-atelier">Chandigarh Atelier &bull; Handcrafted Pure Silks</p>
      </div>
    </div>

    <!-- Right Column: Matte Charcoal Card -->
    <div class="snitch-login-content">
      <div class="snitch-login-card">
        <!-- Dual Luxury Tabs: Track Order & History | VIP Concierge -->
        <div class="account-modal-tabs">
          <button type="button" class="account-modal-tab active" id="tabBtnTrack" onclick="switchAccountTab('track')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7.5" r="4"></circle></svg>
            Track Order &amp; History
          </button>
          <button type="button" class="account-modal-tab" id="tabBtnConcierge" onclick="switchAccountTab('concierge')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            VIP Concierge
          </button>
        </div>

        <!-- TAB 1: ORDER TRACKING & CLIENT SUITE -->
        <div id="accountViewTrack" class="account-view active">
          
          <div style="text-align: left; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
              <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #D4AF37;">
                &#10024; ATELIER VIP ORDER TRACKING
              </span>
              <span style="font-size: 9.5px; background: rgba(212, 175, 55, 0.2); color: #F5E6BE; padding: 2px 7px; border-radius: 3px; font-weight: 700;">
                LIVE STATUS
              </span>
            </div>
            <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 600; color: #FAF8F5; margin: 0 0 4px 0;">
              Find Your Order &amp; Dispatch Details
            </h3>
            <p style="font-size: 11.5px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.4;">
              Enter your Order ID or registered 10-digit mobile number for real-time atelier progress and courier tracking.
            </p>
          </div>

          <label class="snitch-input-heading" for="orderTrackingInput">ORDER ID OR MOBILE NUMBER</label>
          <div class="tracking-input-wrap" style="position: relative; margin-bottom: 10px;">
            <input 
              type="text" 
              id="orderTrackingInput" 
              class="tracking-input-field" 
              placeholder="e.g. #1003 or 9876543210" 
              autocomplete="off"
              onkeydown="if(event.key==='Enter') executeOrderTracking()"
              style="padding-right: 40px;"
            >
            <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #C8A364; pointer-events: none;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </span>
          </div>

          <!-- Quick Suggestions Chips -->
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 14px; flex-wrap: wrap;">
            <span style="font-size: 10px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.05em;">Recent:</span>
            <button type="button" onclick="fillAndTrackDemo('#1003')" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #FAF8F5; font-size: 10.5px; padding: 3px 9px; border-radius: 4px; cursor: pointer; transition: all 0.2s;">
              #1003
            </button>
            <button type="button" onclick="fillAndTrackDemo('#1002')" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #FAF8F5; font-size: 10.5px; padding: 3px 9px; border-radius: 4px; cursor: pointer; transition: all 0.2s;">
              #1002
            </button>
            <button type="button" onclick="fillAndTrackDemo('#1001')" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: #FAF8F5; font-size: 10.5px; padding: 3px 9px; border-radius: 4px; cursor: pointer; transition: all 0.2s;">
              #1001
            </button>
          </div>

          <div id="orderTrackingError" class="snitch-validation-error" style="display:none; margin-bottom:12px;">Please enter an Order ID (e.g. #1003) or a 10-digit mobile number</div>

          <button class="snitch-submit-btn" id="trackOrderSubmitBtn" onclick="executeOrderTracking()" style="background: #C8A364; color: #1E1C19; font-weight: 800; font-size: 11.5px; letter-spacing: 0.08em; box-shadow: 0 4px 14px rgba(200, 163, 100, 0.3);">
            <span>TRACK MY ORDER NOW &rarr;</span>
          </button>

          <!-- Dynamic Shipment Result Card -->
          <div id="trackingResultContainer" style="display:none;"></div>

          <!-- Subtle Official Account Link at Bottom -->
          <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
            <div style="font-size: 11px; color: rgba(255,255,255,0.5); margin-bottom: 6px;">
              Looking for official tax invoices or saved profile?
            </div>
            <a href="/account" style="color: #C8A364; font-size: 11px; font-weight: 700; text-decoration: underline; letter-spacing: 0.04em;">
              Access Shopify Account Portal &rarr;
            </a>
          </div>

        </div>

        <!-- TAB 2: VIP CONCIERGE & PRIVILEGES (ZERO FRICTION) -->
        <div id="accountViewConcierge" class="account-view" style="display:none; text-align:center;">
          <div class="snitch-vip-avatar">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
          <div class="snitch-vip-status-tag">&#10024; ATELIER PRIV&Eacute; CLIENT CARE</div>
          <h3 class="snitch-vip-user" style="font-size:18px; margin: 4px 0 16px;">Direct Atelier Assistance</h3>

          <div class="snitch-vip-perks">
            <div class="snitch-perk-item">
              <div class="snitch-perk-icon">&#128666;</div>
              <div class="snitch-perk-text">
                <strong>Free 24-Hr Tricity Delivery</strong>
                <span>Direct express courier across Chandigarh, Mohali &amp; Panchkula</span>
              </div>
            </div>
            <div class="snitch-perk-item">
              <div class="snitch-perk-icon">&#128087;</div>
              <div class="snitch-perk-text">
                <strong>VIP Atelier Suite Fittings</strong>
                <span>Private trial room appointments at Sector 17, Chandigarh</span>
              </div>
            </div>
            <div class="snitch-perk-item">
              <div class="snitch-perk-icon">&#9986;&#65039;</div>
              <div class="snitch-perk-text">
                <strong>Bespoke Customization</strong>
                <span>Sleeve &amp; neckline tailoring, or urgent dispatch coordination</span>
              </div>
            </div>
          </div>

          <div class="snitch-vip-actions">
            <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20would%20like%20direct%20styling%20and%20order%20assistance." target="_blank" class="shipment-wa-btn" style="margin-top: 10px; margin-bottom: 14px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              Chat on WhatsApp (+91 85116 16133)
            </a>

            <button type="button" class="snitch-submit-btn" style="margin-top: 14px; background: rgba(255,255,255,0.08); color:#FAF8F5;" onclick="closeAccountModalDirect()">
              <span>CONTINUE SHOPPING</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
