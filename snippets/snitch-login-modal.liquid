<!-- MEENU LABEL LUXURY ATELIER SIGN-IN & CLIENT PORTAL MODAL -->
<div class="snitch-login-backdrop" id="accountModalBackdrop" onclick="closeAccountModal(event)">
  <div class="snitch-login-dialog" onclick="event.stopPropagation()">
    <!-- Top Action Buttons -->
    <button class="snitch-dialog-back" onclick="closeAccountModalDirect()" title="Back to Store" aria-label="Back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button class="snitch-dialog-close" onclick="closeAccountModalDirect()" title="Close" aria-label="Close">&times;</button>

    <!-- Left Column: Editorial Campaign Photo -->
    <div class="snitch-login-campaign">
      <img src="{{ 'hero_slide_2.jpg' | asset_url }}" alt="{{ shop.name }}" class="snitch-campaign-photo" onerror="this.src='https://cdn.shopify.com/s/files/1/0722/3325/4983/files/High-Neck_Printed_Kurta_Fashion_Portrait.png?v=1793905387';">
      <div class="snitch-campaign-vignette"></div>
      <div class="snitch-campaign-text">
        <div class="snitch-campaign-pill">&#10024; CHANDIGARH ATELIER</div>
        <h2 class="snitch-campaign-headline">
          WEAR WHAT'S <span class="snitch-headline-accent">TIMELESS</span>
        </h2>
        <p class="snitch-campaign-atelier">Handcrafted Pure Silks &bull; Modern Ethnic Silhouettes</p>
      </div>
    </div>

    <!-- Right Column: Luxury Matte Charcoal Card -->
    <div class="snitch-login-content">
      <div class="snitch-login-card">
        
        {% if customer %}
          <!-- LOGGED-IN CUSTOMER VIEW -->
          <div style="text-align: center; padding: 20px 0;">
            <div style="width: 58px; height: 58px; border-radius: 50%; background: #FAF8F5; color: #1E1C19; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; border: 2px solid #C8A364; margin-bottom: 12px; box-shadow: 0 4px 16px rgba(200, 163, 100, 0.25);">
              {{ customer.first_name | slice: 0 | default: 'M' }}
            </div>
            <div style="font-size: 10px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #D4AF37;">
              &#10024; ATELIER CLIENT ACCESS
            </div>
            <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; font-weight: 600; color: #FAF8F5; margin: 4px 0 2px 0;">
              Welcome back, {{ customer.first_name | default: 'Patron' }}
            </h3>
            <div style="font-size: 12px; color: rgba(255,255,255,0.7); margin-bottom: 24px;">
              {{ customer.email }}
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px;">
              <a href="/pages/my-orders" style="display: flex; align-items: center; justify-content: space-between; padding: 13px 18px; background: #C8A364; color: #1E1C19; text-decoration: none; border-radius: 6px; font-weight: 800; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;">
                <span style="display: flex; align-items: center; gap: 8px;">
                  <span>&#128230;</span> <span>My Orders &amp; Dispatch Status</span>
                </span>
                <span>&rarr;</span>
              </a>

              <a href="/account" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: #FAF8F5; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 12px;">
                <span>Saved Addresses &amp; Profile</span>
                <span>&rarr;</span>
              </a>
            </div>

            <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px;">
              <a href="{{ routes.account_logout_url }}" style="color: rgba(255,255,255,0.5); font-size: 11.5px; text-decoration: underline;">
                Sign Out of Account
              </a>
            </div>
          </div>

        {% else %}
          <!-- GUEST / SIGN-IN VIEW -->
          <div style="text-align: left; margin-bottom: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
              <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #D4AF37;">
                &#10024; ATELIER CLIENT ACCESS
              </span>
              <span style="font-size: 9.5px; background: rgba(212, 175, 55, 0.2); color: #F5E6BE; padding: 2px 7px; border-radius: 3px; font-weight: 700;">
                1-CLICK OTP LOGIN
              </span>
            </div>
            <h3 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 26px; font-weight: 600; color: #FAF8F5; margin: 0 0 6px 0; letter-spacing: 0.02em;">
              Sign In to Meenu Label
            </h3>
            <p style="font-size: 12.5px; color: rgba(255,255,255,0.7); margin: 0; line-height: 1.45;">
              Enter your email to receive a secure 6-digit login code. No password needed.
            </p>
          </div>

          <!-- Email Login Form -->
          <form action="/account/login" method="get" id="atelierLoginForm" onsubmit="return handleAtelierLoginSubmit(event)" style="margin-bottom: 18px;">
            <label class="snitch-input-heading" for="atelierLoginEmail">YOUR EMAIL ADDRESS</label>
            <div class="tracking-input-wrap" style="position: relative; margin-bottom: 12px;">
              <input 
                type="email" 
                name="email" 
                id="atelierLoginEmail" 
                class="tracking-input-field" 
                placeholder="name@example.com" 
                required 
                autocomplete="email"
                style="padding-right: 42px;"
              >
              <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #C8A364; pointer-events: none;">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </span>
            </div>

            <div id="atelierLoginError" class="snitch-validation-error" style="display:none; margin-bottom:12px;">Please enter a valid email address</div>

            <button type="submit" class="snitch-submit-btn" id="atelierLoginSubmitBtn" style="background: #C8A364; color: #1E1C19; font-weight: 800; font-size: 11.5px; letter-spacing: 0.08em; box-shadow: 0 4px 14px rgba(200, 163, 100, 0.35);">
              <span>CONTINUE WITH 6-DIGIT CODE &rarr;</span>
            </button>
          </form>

          <!-- Direct Alternative Actions (Flipkart/Myntra/Amazon Style) -->
          <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px; margin-top: 8px;">
            <div style="font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-bottom: 10px; text-align: center;">
              Instant Client Services (No Login Required)
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
              <a href="/pages/my-orders" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 10px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 6px; text-decoration: none; color: #FAF8F5; text-align: center; transition: all 0.2s;">
                <span style="font-size: 16px; margin-bottom: 4px;">&#128230;</span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;">My Orders</span>
                <span style="font-size: 9.5px; color: #C8A364; margin-top: 2px;">Track Dispatch</span>
              </a>

              <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20would%20like%20assistance%20with%20my%20account%20or%20orders." target="_blank" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 12px 10px; background: rgba(37, 211, 102, 0.1); border: 1px solid rgba(37, 211, 102, 0.25); border-radius: 6px; text-decoration: none; color: #FAF8F5; text-align: center; transition: all 0.2s;">
                <span style="font-size: 16px; margin-bottom: 4px;">&#128172;</span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: #25D366;">WhatsApp</span>
                <span style="font-size: 9.5px; color: rgba(255,255,255,0.6); margin-top: 2px;">VIP Concierge</span>
              </a>
            </div>
          </div>

          <div style="margin-top: 18px; text-align: center; font-size: 11px; color: rgba(255,255,255,0.5);">
            Secured by Shopify 256-bit encryption &bull; Sector 17, Chandigarh Atelier
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>

<script>
  function handleAtelierLoginSubmit(e) {
    if (e && e.preventDefault) e.preventDefault();
    var emailInput = document.getElementById('atelierLoginEmail');
    var errorDiv = document.getElementById('atelierLoginError');
    var submitBtn = document.getElementById('atelierLoginSubmitBtn');

    if (!emailInput || !emailInput.value || !emailInput.value.includes('@')) {
      if (errorDiv) {
        errorDiv.textContent = 'Please enter a valid email address';
        errorDiv.style.display = 'block';
      }
      return false;
    }

    if (errorDiv) errorDiv.style.display = 'none';
    if (submitBtn) {
      submitBtn.innerHTML = '<span>CONNECTING SECURE LOGIN...</span>';
      submitBtn.style.opacity = '0.75';
      submitBtn.style.pointerEvents = 'none';
    }

    // Save entered email in localStorage for instant retrieval across pages
    try {
      localStorage.setItem('meenu_customer_email', emailInput.value.trim());
    } catch(err) {}

    // Clean GET navigation to Shopify 1-click code auth (NO invalid raw POST)
    window.location.href = '/account/login';
    return false;
  }
</script>
