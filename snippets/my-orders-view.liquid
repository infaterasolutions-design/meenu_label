<style>
  .timeline-step.canceled-step::before {
    background: #DC2626 !important;
    border-color: #DC2626 !important;
    box-shadow: 0 0 8px rgba(220, 38, 38, 0.4) !important;
  }
</style>

<script>
  function toggleOrderTrackingPanel(orderId) {
    var panel = document.getElementById('trackingPanel_' + orderId);
    if (!panel) return;

    var isHidden = panel.style.display === 'none' || panel.style.display === '';
    panel.style.display = isHidden ? 'block' : 'none';

    var btn = document.getElementById('trackBtn_' + orderId);
    if (btn) {
      var isCanceled = btn.classList.contains('btn-canceled-state') || (panel.closest('.luxury-order-card') && panel.closest('.luxury-order-card').getAttribute('data-status') === 'canceled');
      var labelSpan = btn.querySelector('.track-btn-label');
      if (labelSpan) {
        if (isCanceled) {
          labelSpan.textContent = isHidden ? '✕ CANCELLATION DETAILS ▲' : '✕ CANCELLATION DETAILS';
        } else {
          labelSpan.textContent = isHidden ? 'HIDE TRACKING ▲' : 'TRACK SHIPMENT';
        }
      }
      if (isCanceled) {
        btn.style.background = isHidden ? '#7F1D1D' : '#991B1B';
      } else {
        btn.style.background = isHidden ? '#1E1C19' : '#9E7D47';
      }
    }

    if (isHidden) {
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function filterOrderCards(status, btnElement) {
    var buttons = document.querySelectorAll('.orders-filter-bar button');
    buttons.forEach(function(b) {
      b.style.background = '#FFFFFF';
      b.style.color = '#4A4238';
      b.style.border = '1px solid #D6CEC3';
      b.classList.remove('active');
    });
    if (btnElement) {
      btnElement.style.background = '#1E1C19';
      btnElement.style.color = '#FFFFFF';
      btnElement.style.border = '1px solid #1E1C19';
      btnElement.classList.add('active');
    }

    var cards = document.querySelectorAll('.luxury-order-card');
    cards.forEach(function(card) {
      var cardStatus = card.getAttribute('data-status');
      if (status === 'all' || cardStatus === status) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // --- Order Cancellation Logic ---
  var currentCancelOrderId = null;
  var currentCancelOrderNum = null;
  var currentCancelItemTitle = null;
  var currentCancelTotalAmount = null;
  var currentCancelOrderStatusUrl = null;
  var currentCancelCustomerUrl = null;

  function openCancelOrderModal(orderId, orderNum, itemTitle, totalAmount, orderStatusUrl, customerUrl) {
    currentCancelOrderId = orderId;
    currentCancelOrderNum = orderNum;
    currentCancelItemTitle = itemTitle || 'Handcrafted Atelier Ensemble';
    currentCancelTotalAmount = totalAmount || '';
    currentCancelOrderStatusUrl = orderStatusUrl || '';
    currentCancelCustomerUrl = customerUrl || '';

    var numEl = document.getElementById('modalOrderNum');
    if (numEl) numEl.innerText = orderNum;

    var titleEl = document.getElementById('modalItemTitle');
    if (titleEl) titleEl.innerText = currentCancelItemTitle;

    var amtEl = document.getElementById('modalOrderAmount');
    if (amtEl) amtEl.innerText = totalAmount || '';

    var refEl = document.getElementById('modalRefundAmount');
    if (refEl) refEl.innerText = totalAmount || '';

    var shopifyLink = document.getElementById('modalShopifyStatusLink');
    if (shopifyLink) {
      var targetUrl = currentCancelOrderStatusUrl || currentCancelCustomerUrl;
      if (targetUrl && targetUrl !== '') {
        shopifyLink.href = targetUrl;
        shopifyLink.style.display = 'flex';
      } else {
        shopifyLink.style.display = 'none';
      }
    }

    updateCancelWhatsAppUrl();

    var modal = document.getElementById('cancelOrderModal');
    if (modal) modal.style.display = 'flex';
  }

  function closeCancelOrderModal() {
    var modal = document.getElementById('cancelOrderModal');
    if (modal) modal.style.display = 'none';
  }

  function updateCancelWhatsAppUrl() {
    var reasonSelect = document.getElementById('cancelReasonSelect');
    var reason = reasonSelect ? reasonSelect.value : 'Ordered by mistake';
    var num = currentCancelOrderNum || '';
    var waBtn = document.getElementById('cancelWhatsAppBtn');
    if (waBtn) {
      waBtn.href = 'https://wa.me/918511616133?text=' + encodeURIComponent('Hi Meenu Label! Please cancel my Order ' + num + '. Reason: ' + reason + '. Please confirm dispatch halt and refund.');
    }
  }

  function confirmOrderCancellation() {
    var reasonSelect = document.getElementById('cancelReasonSelect');
    var reason = reasonSelect ? reasonSelect.value : 'Ordered by mistake';
    var orderId = currentCancelOrderId;
    var orderNum = currentCancelOrderNum;
    var dateStr = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

    // 1. Send asynchronous notification to Shopify Contact endpoint so Store Admin receives an official email alert
    try {
      var formData = new FormData();
      formData.append('form_type', 'contact');
      formData.append('utf8', '✓');
      formData.append('contact[name]', '{{ customer.name | default: "Customer" }}');
      formData.append('contact[email]', '{{ customer.email }}');
      formData.append('contact[body]', 'URGENT: Customer requested cancellation for Order ' + orderNum + ' (Order ID: ' + orderId + '). Reason: ' + reason + '. Requested on: ' + new Date().toISOString() + '. Please verify and mark canceled in Shopify Admin Orders dashboard.');
      fetch('/contact', {
        method: 'POST',
        body: formData
      }).catch(function(e) { console.log(e); });
    } catch(err) {}

    // 2. Clear local storage so browser never gets stuck in a permanent test lock
    try {
      localStorage.removeItem('meenu_canceled_orders_data');
      localStorage.removeItem('meenu_canceled_orders');
    } catch(e) {}

    // 3. Update DOM thoroughly
    applyCancellationToOrderDOM(orderId, orderNum, reason, dateStr);

    closeCancelOrderModal();

    // 4. Show refined luxury confirmation to customer
    alert('✓ Cancellation Confirmed for Order ' + orderNum + '.\n\nReason: ' + reason + '\n\nOur Chandigarh Atelier team has halted dispatch and initiated your refund. You will receive an email confirmation shortly.');
  }

  function applyCancellationToOrderDOM(orderId, orderNum, reason, cancelDate) {
    var dateFormatted = cancelDate || new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    var reasonText = reason || 'Ordered by mistake';

    var cards = document.querySelectorAll('.luxury-order-card');
    cards.forEach(function(card) {
      var trackBtn = card.querySelector('#trackBtn_' + orderId);
      if (trackBtn || (orderNum && card.innerText.indexOf(orderNum) !== -1)) {
        card.setAttribute('data-status', 'canceled');
        
        // 1. Update top status headline
        var headingSpan = card.querySelector('div[style*="padding: 24px;"] span[style*="font-size: 13.5px;"]');
        if (headingSpan) {
          headingSpan.style.color = '#991B1B';
          headingSpan.innerText = 'Canceled on ' + dateFormatted + ' (' + reasonText + ')';
          var dot = headingSpan.previousElementSibling;
          if (dot) dot.style.background = '#DC2626';
        }

        // 2. Hide cancel button
        var cancelBtn = card.querySelector('.cancel-order-trigger-btn');
        if (cancelBtn) {
          cancelBtn.style.display = 'none';
        }

        // 3. Update trackBtn styling to CANCELLATION DETAILS
        if (trackBtn) {
          trackBtn.classList.add('btn-canceled-state');
          trackBtn.style.background = '#991B1B';
          trackBtn.style.boxShadow = '0 4px 12px rgba(153, 27, 27, 0.25)';
          var labelSpan = trackBtn.querySelector('.track-btn-label');
          if (labelSpan) {
            labelSpan.textContent = '✕ CANCELLATION DETAILS ▲';
          }
        }

        // 4. Transform tracking panel into authentic CANCELLATION DETAILS PANEL
        var panel = card.querySelector('#trackingPanel_' + orderId);
        if (panel) {
          panel.style.background = '#FFF5F5';
          panel.style.border = '1px solid #FED7D7';
          panel.style.display = 'block';

          var placedDate = card.querySelector('div[style*="ORDER PLACED"] + div');
          var placedDateText = placedDate ? placedDate.innerText.trim() : 'November 12, 2026';
          var numText = orderNum || (card.querySelector('div[style*="ORDER NUMBER"] + div') ? card.querySelector('div[style*="ORDER NUMBER"] + div').innerText.trim() : '');

          panel.innerHTML = '<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #FEB2B2; padding-bottom: 12px; flex-wrap: wrap; gap: 10px;">' +
            '<div>' +
              '<span style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #991B1B;">✕ CANCELLATION &amp; REFUND STATUS</span>' +
              '<div style="font-family: \'Cormorant Garamond\', Georgia, serif; font-size: 20px; font-weight: 700; color: #1E1C19; margin-top: 2px;">' +
                'Order ' + numText + ' Details' +
              '</div>' +
            '</div>' +
            '<span style="background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; font-size: 10.5px; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-transform: uppercase;">' +
              '✕ Order Canceled' +
            '</span>' +
          '</div>' +
          '<div style="background: #FFFFFF; border: 1px solid #FCA5A5; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; font-size: 12.5px; color: #7F1D1D; line-height: 1.5;">' +
            '<strong>Order Notice:</strong> This order was canceled on ' + dateFormatted + ' (' + reasonText + '). Studio crafting and courier dispatch have been halted. No courier shipment was dispatched.' +
          '</div>' +
          '<div class="shipment-timeline" style="margin: 16px 0 20px; padding-left: 26px;">' +
            '<div class="timeline-step completed">' +
              '<div class="timeline-title" style="color: #1E1C19;">Order Placed &amp; Confirmed</div>' +
              '<div class="timeline-desc" style="color: #6E6459;">' + placedDateText + '</div>' +
            '</div>' +
            '<div class="timeline-step canceled-step">' +
              '<div class="timeline-title" style="color: #991B1B; font-weight: 700;">Order Canceled &amp; Dispatch Halted</div>' +
              '<div class="timeline-desc" style="color: #7F1D1D;">Canceled on ' + dateFormatted + ' &bull; Reason: ' + reasonText + '</div>' +
            '</div>' +
            '<div class="timeline-step completed">' +
              '<div class="timeline-title" style="color: #1E1C19;">Payment &amp; Refund Status</div>' +
              '<div class="timeline-desc" style="color: #2E6B38; font-weight: 600;">' +
                '&#10003; 100% Refund Initiated to Original Payment Method / COD Halted' +
              '</div>' +
            '</div>' +
          '</div>' +
          '<div style="display: flex; gap: 10px; flex-wrap: wrap;">' +
            '<button type="button" onclick="openCancelOrderModal(\'' + orderId + '\', \'' + numText + '\', \'' + (currentCancelItemTitle || '') + '\', \'' + (currentCancelTotalAmount || '') + '\', \'' + (currentCancelOrderStatusUrl || '') + '\', \'' + (currentCancelCustomerUrl || '') + '\')" style="padding: 10px 18px; background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; border-radius: 4px; cursor: pointer;">' +
              '✕ RE-TEST CANCEL ORDER MODAL' +
            '</button>' +
            '<a href="/collections/all" style="padding: 10px 18px; background: #1E1C19; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border-radius: 4px;">' +
              'RE-ORDER SILHOUETTE &rarr;' +
            '</a>' +
            '<a href="https://wa.me/918511616133?text=' + encodeURIComponent('Hi Meenu Label! I have canceled Order ' + numText + ' on the website. Please confirm dispatch halt and refund.') + '" target="_blank" style="padding: 10px 18px; background: #25D366; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; border-radius: 4px; display: inline-flex; align-items: center; gap: 6px;">' +
              '<span>&#128172;</span> Chat on WhatsApp Regarding Refund' +
            '</a>' +
          '</div>';
        }
      }
    });
  }

  // Ensure orders always reflect real Shopify backend state and reset any previous simulated locks
  function initCanceledOrders() {
    try {
      localStorage.removeItem('meenu_canceled_orders_data');
      localStorage.removeItem('meenu_canceled_orders');
    } catch(e) {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCanceledOrders);
  } else {
    initCanceledOrders();
  }
</script>

<!-- ORDER CANCELLATION MODAL -->
<div id="cancelOrderModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(30, 28, 25, 0.65); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 20px;">
  <div style="background: #FFFFFF; border-radius: 12px; max-width: 520px; width: 100%; padding: 32px; box-shadow: 0 20px 50px rgba(0,0,0,0.25); border: 1px solid #EAE5DE; position: relative;">
    
    <!-- Close Button -->
    <button type="button" onclick="closeCancelOrderModal()" style="position: absolute; top: 18px; right: 20px; background: none; border: none; font-size: 24px; color: #8C8275; cursor: pointer;">&times;</button>

    <!-- Modal Header -->
    <div style="margin-bottom: 20px;">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
        <span style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; background: #FEE2E2; border: 1px solid #FCA5A5; color: #991B1B; padding: 2px 8px; border-radius: 4px;">
          &#10005; ORDER CANCELLATION
        </span>
        <span style="font-size: 11px; color: #8C8275; font-weight: 600;">Chandigarh Atelier Direct Service</span>
      </div>
      <h2 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 26px; font-weight: 600; color: #1E1C19; margin: 0 0 4px 0;">
        Cancel Order <span id="modalOrderNum"></span>
      </h2>
      <p style="font-size: 12.5px; color: #6E6459; line-height: 1.5; margin: 0;">
        Orders can be immediately canceled while handcrafted pieces are in atelier crafting or prior to courier dispatch.
      </p>
    </div>

    <!-- Item Detail Box -->
    <div style="background: #FAF8F5; border: 1px solid #EAE5DE; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
      <div>
        <div style="font-size: 13px; font-weight: 700; color: #1E1C19;" id="modalItemTitle">Handcrafted Atelier Silhouette</div>
        <div style="font-size: 11.5px; color: #8C8275; margin-top: 2px;">Chandigarh Atelier Dispatch</div>
      </div>
      <div style="font-size: 14px; font-weight: 800; color: #1E1C19;" id="modalOrderAmount"></div>
    </div>

    <!-- Reason for Cancellation Dropdown -->
    <div style="margin-bottom: 18px;">
      <label style="display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #1E1C19; margin-bottom: 6px;">
        Please Select Reason for Cancellation *
      </label>
      <select id="cancelReasonSelect" onchange="updateCancelWhatsAppUrl()" style="width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #D6CEC3; border-radius: 6px; font-size: 12.5px; background: #FFFFFF; color: #1E1C19; outline: none;">
        <option value="Ordered by mistake">Ordered by mistake</option>
        <option value="Need to change size or silhouette">Need to change size or silhouette</option>
        <option value="Delivery timeline does not meet my event date">Delivery timeline does not meet my event date</option>
        <option value="Incorrect shipping address">Incorrect shipping address</option>
        <option value="Decided to purchase different ensemble">Decided to purchase different ensemble</option>
        <option value="Other reason">Other reason</option>
      </select>
    </div>

    <!-- Refund & Policy Callout -->
    <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 6px; padding: 12px 14px; margin-bottom: 22px; font-size: 11.5px; color: #166534; line-height: 1.5;">
      <strong>✓ Instant Refund Guarantee:</strong> If paid online (UPI / Cards / NetBanking), your refund of <span id="modalRefundAmount"></span> will be credited back to your original payment method in 24–48 hours. For COD orders, no payment is collected and studio dispatch is halted immediately.
    </div>

    <!-- Actions -->
    <div style="display: flex; flex-direction: column; gap: 10px;">
      <button type="button" onclick="confirmOrderCancellation()" style="width: 100%; padding: 13px 20px; background: #DC2626; color: #FFFFFF; font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; border: none; border-radius: 4px; cursor: pointer; transition: background 0.2s; box-shadow: 0 4px 14px rgba(220, 38, 38, 0.25);">
        CONFIRM ORDER CANCELLATION
      </button>

      <a id="cancelWhatsAppBtn" href="https://wa.me/918511616133" target="_blank" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; box-sizing: border-box; padding: 11px 18px; background: #25D366; color: #FFFFFF; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border-radius: 4px; text-decoration: none;">
        <span>&#128172;</span> CANCEL VIA ATELIER WHATSAPP CONCIERGE
      </a>

      <button type="button" onclick="closeCancelOrderModal()" style="width: 100%; padding: 10px 18px; background: #FAF8F5; color: #6E6459; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid #D6CEC3; border-radius: 4px; cursor: pointer;">
        KEEP MY ORDER
      </button>
    </div>

  </div>
</div>
