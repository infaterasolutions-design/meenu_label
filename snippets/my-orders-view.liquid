    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .my-orders-page-section .shipment-timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 5px;
    width: 2px;
    background: #D6CEC3 !important;
  }
  .my-orders-page-section .timeline-step {
    position: relative;
  }
  .my-orders-page-section .timeline-step::before {
    content: '';
    position: absolute;
    left: -24px;
    top: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid #C4B9A9;
    box-sizing: border-box;
  }
  .my-orders-page-section .timeline-step.completed::before {
    background: #25D366 !important;
