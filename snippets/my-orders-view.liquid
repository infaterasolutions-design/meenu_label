{% assign my_orders_login_url_with_return = '/customer_authentication/login?return_to=/pages/my-orders' %}
<div class="my-orders-page-section">
  <div class="my-orders-container">
    
    <!-- Breadcrumb -->
    <div class="orders-breadcrumb">
      <a href="/">HOME</a> &nbsp;/&nbsp; 
      <a href="/pages/account">MY ACCOUNT</a> &nbsp;/&nbsp; 
      <span class="breadcrumb-current">MY ORDERS</span>
    </div>

    <!-- Header Banner -->
    <div class="orders-header-card">
      <div class="orders-header-main-col">
        <div class="orders-badge-row">
          <span class="orders-atelier-badge">&#10024; ATELIER CLIENT PORTAL</span>
          <span class="orders-header-perks-desktop">Live Status &bull; 1-Click Tracking &bull; Doorstep Exchanges</span>
          <div class="orders-header-action-mobile">
            <a href="/collections/all" class="orders-header-cta-btn-mobile">
              EXPLORE DROP 01 &rarr;
            </a>
          </div>
        </div>
        <h1 class="orders-header-title">
          My Orders &amp; Purchases
        </h1>
        <div class="orders-header-subtitle">
          Review all your handcrafted ensembles, live dispatch timelines, and cancellation records.
        </div>
      </div>

      <div class="orders-header-action-desktop">
        <a href="/collections/all" class="orders-header-cta-btn-desktop">
          EXPLORE DROP 01 &rarr;
        </a>
      </div>
    </div>

    {% if customer %}
      <!-- 1. AUTHENTICATED CUSTOMER VIEW -->
      {% if customer.orders.size > 0 %}
        <!-- Order Status Filter Pills (Flipkart/Myntra Horizontal Touch Scroll) -->
        <div class="orders-filter-bar">
          <button type="button" class="order-filter-pill active" onclick="filterOrderCards('all', this)">
            All Orders ({{ customer.orders.size }})
          </button>
          <button type="button" class="order-filter-pill" onclick="filterOrderCards('dispatched', this)">
            Dispatched / In Transit
          </button>
          <button type="button" class="order-filter-pill" onclick="filterOrderCards('delivered', this)">
            Delivered
          </button>
          <button type="button" class="order-filter-pill" onclick="filterOrderCards('canceled', this)">
            Canceled
          </button>
        </div>

        <!-- ORDERS CONTAINER (REAL SHOPIFY ORDERS) -->
        <div id="myOrdersListContainer" class="orders-list-container">
          {% for order in customer.orders %}
            {% assign is_order_canceled = false %}
            {% if order.cancelled or order.cancel_reason != blank or order.financial_status == 'refunded' or order.financial_status == 'voided' or order.tags contains 'canceled' or order.tags contains 'cancelled' or order.tags contains 'Cancellation requested' or order.line_items.size == 0 %}
              {% assign is_order_canceled = true %}
            {% endif %}
            
            <div class="luxury-order-card codify-order-item" id="order_{{ order.id }}" data-order-id="{{ order.id }}" data-order-number="{{ order.name }}" data-order-status-url="{{ order.order_status_url }}" data-status="{% if is_order_canceled %}canceled{% elsif order.fulfillment_status == 'fulfilled' %}delivered{% else %}dispatched{% endif %}">
              
              <!-- Card Header Bar Desktop (Amazon / Myntra Style) -->
              <div class="order-card-header-desktop">
                <div class="order-header-meta-group">
                  <div class="order-meta-col">
                    <div class="order-meta-label">ORDER PLACED</div>
                    <div class="order-meta-val">{{ order.created_at | date: "%B %d, %Y" }}</div>
                  </div>
                  <div class="order-meta-col">
                    <div class="order-meta-label">TOTAL AMOUNT</div>
                    <div class="order-meta-val total-price-val">{{ order.total_price | money }}</div>
                  </div>
                  <div class="order-meta-col">
                    <div class="order-meta-label">SHIP TO</div>
                    <div class="order-meta-val">{{ order.shipping_address.name | default: customer.name }}</div>
                  </div>
                </div>

                <div class="order-header-number-group">
                  <div class="order-meta-label">ORDER NUMBER</div>
                  <div class="order-number-title">{{ order.name }}</div>
                </div>
              </div>

              <!-- Card Header Bar Mobile (Compact Luxury View) -->
              <div class="order-card-header-mobile">
                <div class="order-mob-header-top">
                  <div class="order-mob-number">
                    <span>Order</span> <strong>{{ order.name }}</strong>
                  </div>
                  <div class="order-mob-status-pill status-pill-{% if is_order_canceled %}canceled{% elsif order.fulfillment_status == 'fulfilled' %}delivered{% else %}active{% endif %}">
                    {% if is_order_canceled %}
                      <span class="status-dot-mini red"></span> Canceled
                    {% elsif order.fulfillment_status == 'fulfilled' %}
                      <span class="status-dot-mini green"></span> Delivered
                    {% else %}
                      <span class="status-dot-mini amber"></span> In Transit
                    {% endif %}
                  </div>
                </div>
                <div class="order-mob-header-sub">
                  <span>{{ order.created_at | date: "%b %d, %Y" }}</span>
                  <span class="sub-dot">&bull;</span>
                  <span class="mob-sub-price">{{ order.total_price | money }}</span>
                  {% if order.shipping_address.first_name != blank %}
                    <span class="sub-dot">&bull;</span>
                    <span class="mob-sub-name">Ship to {{ order.shipping_address.first_name }}</span>
                  {% endif %}
                </div>
              </div>

              <!-- Card Body: Products & Status -->
              <div class="order-card-body">
                
                <!-- Desktop Status Heading -->
                <div class="order-card-status-headline-desktop">
                  <div class="status-indicator-left">
                    {% if is_order_canceled %}
                      <span class="status-dot red"></span>
                      <span class="status-text red">
                        Canceled on {{ order.cancelled_at | default: order.created_at | date: "%B %d, %Y" }}
                        {% if order.cancel_reason != blank and order.cancel_reason != 'other' %}
                          ({{ order.cancel_reason | capitalize }})
                        {% endif %}
                      </span>
                    {% elsif order.fulfillment_status == 'fulfilled' %}
                      <span class="status-dot green"></span>
                      <span class="status-text green">Delivered</span>
                    {% else %}
                      <span class="status-dot amber"></span>
                      <span class="status-text amber">Atelier Crafting &bull; Express Dispatch in Progress</span>
                    {% endif %}
                  </div>

                  <span class="order-craft-tag">
                    Chandigarh Atelier &bull; Handcrafted Pure Silk
                  </span>
                </div>

                <!-- Product Lines -->
                {% for line_item in order.line_items %}
                  <div class="order-product-item">
                    <div class="order-product-main">
                      {% if line_item.image %}
                        <img src="{{ line_item.image | image_url: width: 180 }}" alt="{{ line_item.title }}" class="order-product-img">
                      {% endif %}

                      <div class="order-product-details">
                        <a href="{{ line_item.url }}" class="order-product-title">
                          {{ line_item.title }}
                        </a>
                        {% if line_item.variant.title != 'Default Title' %}
                          <div class="order-product-variant">
                            Size / Variant: <strong>{{ line_item.variant.title }}</strong>
                          </div>
                        {% endif %}
                        <div class="order-product-pricing">
                          <span class="item-price">{{ line_item.final_price | money }}</span>
                          <span class="item-qty">&bull; Qty: {{ line_item.quantity }}</span>
                        </div>
                      </div>
                    </div>

                    <!-- Actions per item (Amazon/Flipkart Style Desktop + 2-Column Mobile Grid) -->
                    <div class="order-product-actions">
                      <div class="order-actions-buttons-row">
                        <button type="button" onclick="toggleOrderTrackingPanel('{{ order.id }}')" id="trackBtn_{{ order.id }}" class="order-btn-track {% if is_order_canceled %}btn-canceled-state{% endif %}">
                          <span>&#128230;</span> <span class="track-btn-label">{% if is_order_canceled %}✕ CANCELLATION DETAILS{% else %}TRACK SHIPMENT{% endif %}</span>
                        </button>
                        
                        {% if is_order_canceled or order.fulfillment_status == 'fulfilled' %}
                          <a href="{{ line_item.url }}" class="order-btn-buyagain">
                            BUY IT AGAIN
                          </a>
                        {% else %}
                          <button type="button" class="cancel-order-trigger-btn codify-custom-cancel-trigger order-btn-cancel" data-order-id="{{ order.id }}" onclick="openCancelOrderModal('{{ order.id }}', '{{ order.name }}', '{{ line_item.title | escape }}', '{{ order.total_price | money }}', '{{ order.order_status_url }}', '{{ order.customer_url }}')">
                            <span>&#10005;</span> CANCEL ORDER
                          </button>
                          <!-- Codify App Injected Container Hook -->
                          <div class="codify-cancel-button-wrapper" data-order-id="{{ order.id }}"></div>
                        {% endif %}
                      </div>

                      <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20{{ line_item.title | url_encode }}%20from%20Order%20{{ order.name }}." target="_blank" class="order-wa-link">
                        <span>&#128172;</span> Chat with Stylist on WhatsApp
                      </a>
                    </div>
                  </div>
                {% endfor %}

                <!-- EXPANDABLE PANEL (CANCELED VS ACTIVE) -->
                {% if is_order_canceled %}
                  <!-- CANCELLATION DETAILS PANEL -->
                  <div id="trackingPanel_{{ order.id }}" class="order-tracking-panel canceled-panel" style="display: none;">
                    <div class="order-tracking-panel-header canceled-header">
                      <div>
                        <span class="tracking-panel-tag red">&#10005; CANCELLATION &amp; REFUND STATUS</span>
                        <div class="tracking-panel-title">
                          Order {{ order.name }} Details
                        </div>
                      </div>
                      <span class="tracking-panel-status-pill red">
                        &#10005; Order Canceled
                      </span>
                    </div>

                    <div class="cancellation-notice-box">
                      <strong>Order Notice:</strong> This order was canceled on {{ order.cancelled_at | date: "%B %d, %Y" }}. Because the order was canceled, no courier shipment was dispatched.
                    </div>

                    <div class="shipment-timeline">
                      <div class="timeline-step completed">
                        <div class="timeline-title">Order Placed &amp; Confirmed</div>
                        <div class="timeline-desc">{{ order.created_at | date: "%B %d, %Y at %I:%M %p" }}</div>
                      </div>
                      <div class="timeline-step canceled-step">
                        <div class="timeline-title red">Order Canceled</div>
                        <div class="timeline-desc red">Canceled on {{ order.cancelled_at | date: "%B %d, %Y" }}</div>
                      </div>
                      <div class="timeline-step completed">
                        <div class="timeline-title">Payment &amp; Refund Status</div>
                        <div class="timeline-desc green">
                          {% if order.financial_status == 'refunded' %}
                            &#10003; 100% Refund Completed
                          {% else %}
                            &#10003; {{ order.financial_status | capitalize }} (No pending balance)
                          {% endif %}
                        </div>
                      </div>
                    </div>

                    <div class="tracking-panel-actions">
                      <a href="/collections/all" class="tracking-panel-btn dark">
                        RE-ORDER SILHOUETTE &rarr;
                      </a>
                      <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20my%20canceled%20Order%20{{ order.name }}." target="_blank" class="tracking-panel-btn wa">
                        <span>&#128172;</span> Chat on WhatsApp Regarding Refund
                      </a>
                    </div>
                  </div>

                {% else %}
                  <!-- ACTIVE SHIPMENT TIMELINE PANEL -->
                  <div id="trackingPanel_{{ order.id }}" class="order-tracking-panel active-panel" style="display: none;">
                    <div class="order-tracking-panel-header active-header">
                      <div>
                        <span class="tracking-panel-tag gold">LIVE SHIPMENT TIMELINE</span>
                        <div class="tracking-panel-title">
                          Order {{ order.name }} Status
                        </div>
                      </div>
                      <span class="tracking-panel-status-pill green">
                        {% if order.fulfillment_status == 'fulfilled' %}&#10003; Delivered{% else %}&#9203; In Process{% endif %}
                      </span>
                    </div>

                    <div class="shipment-timeline">
                      <div class="timeline-step completed">
                        <div class="timeline-title">Order Confirmed &amp; Silk Reserved</div>
                        <div class="timeline-desc">Chandigarh Studio Atelier &bull; Fabrics allocated</div>
                      </div>
                      <div class="timeline-step completed">
                        <div class="timeline-title">Handcrafted &amp; Master Quality Inspected</div>
                        <div class="timeline-desc">Passed 14-point artisan luxury inspection</div>
                      </div>
                      <div class="timeline-step {% if order.fulfillment_status == 'fulfilled' %}completed{% else %}active{% endif %}">
                        <div class="timeline-title">Dispatched in Express Transit</div>
                        <div class="timeline-desc">Express Courier Handover &bull; Tricity / National Air</div>
                      </div>
                      <div class="timeline-step {% if order.fulfillment_status == 'fulfilled' %}completed{% endif %}">
                        <div class="timeline-title">Out for Delivery &amp; VIP Handover</div>
                        <div class="timeline-desc">Direct delivery to {{ order.shipping_address.name | default: 'Customer Destination' }}</div>
                      </div>
                    </div>

                    <div class="tracking-panel-actions">
                      <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20please%20share%20courier%20tracking%20update%20for%20Order%20{{ order.name }}." target="_blank" class="tracking-panel-btn wa">
                        <span>&#128172;</span> Chat With Atelier Stylist
                      </a>
                      <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20need%20a%20doorstep%20size%20exchange%20for%20Order%20{{ order.name }}." target="_blank" class="tracking-panel-btn outline">
                        <span>&#128087;</span> Request Doorstep Size Exchange
                      </a>
                      {% unless is_order_canceled or order.fulfillment_status == 'fulfilled' %}
                        <button type="button" class="tracking-panel-btn cancel-light" onclick="openCancelOrderModal('{{ order.id }}', '{{ order.name }}', '{{ order.line_items.first.title | escape }}', '{{ order.total_price | money }}', '{{ order.order_status_url }}', '{{ order.customer_url }}')">
                          &#10005; Cancel This Order
                        </button>
                      {% endunless %}
                    </div>
                  </div>
                {% endif %}

              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <!-- CUSTOMER LOGGED IN WITH 0 ORDERS -->
        <div class="orders-empty-state">
          <div class="empty-icon-circle">
            &#128087;
          </div>
          <div class="empty-state-tag">
            ATELIER ORDER ARCHIVE
          </div>
          <h2 class="empty-state-title">
            No Orders Found Yet
          </h2>
          <p class="empty-state-desc">
            You have not placed any orders under <strong>{{ customer.email }}</strong> yet. Explore our handcrafted debut capsule drop.
          </p>
          <a href="/collections/all" class="empty-state-cta">
            EXPLORE DROP 01 SILHOUETTES &rarr;
          </a>
        </div>
      {% endif %}

    {% else %}
      <!-- 2. GUEST / LOGGED-OUT: ATELIER CONFIDENTIALITY GATE (ZERO FAKE ORDERS) -->
      <div class="orders-guest-gate">
        <div class="guest-gate-icon">
          &#128274;
        </div>

        <div class="guest-gate-tag">
          ATELIER CONFIDENTIALITY &bull; SIGN IN REQUIRED
        </div>

        <h2 class="guest-gate-title">
          Sign In to View Your Purchases
        </h2>

        <p class="guest-gate-desc">
          Your order records, doorstep exchange status, and live courier tracking are private. Please sign in to your Atelier Account to view your purchases.
        </p>

        <div class="guest-gate-actions">
          <a href="{{ my_orders_login_url_with_return }}" class="guest-btn-primary">
            SIGN IN TO YOUR ACCOUNT &rarr;
          </a>

          <a href="/collections/all" class="guest-btn-secondary">
            EXPLORE DROP 01 SILHOUETTES
          </a>
        </div>

        <div class="guest-gate-footer">
          Looking for a guest checkout order? 
          <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20placed%20an%20order%20as%20a%20guest%20and%20need%20tracking%20assistance." target="_blank" class="guest-wa-link">
            Chat on WhatsApp (+91 85116 16133)
          </a>
        </div>
      </div>
    {% endif %}

    <!-- Atelier Privilege Banner -->
    <div class="orders-care-banner">
      <div class="orders-care-text">
        <div class="orders-care-tag">
          &#10024; ATELIER CLIENT CARE
        </div>
        <div class="orders-care-title">
          Questions About an Order or Delivery?
        </div>
        <div class="orders-care-sub">
          Free 7-day exchange window &bull; Sector 17, Chandigarh Direct Concierge
        </div>
      </div>
      <a href="https://wa.me/918511616133?text=Hi%20Meenu%20Label%2C%20I%20have%20an%20inquiry%20regarding%20my%20orders." target="_blank" class="orders-care-wa-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
        CHAT ON WHATSAPP (+91 85116 16133)
      </a>
    </div>

  </div>
</div>

<!-- STYLES -->
<style>
  .my-orders-page-section {
    background: #FAF8F5;
    min-height: 85vh;
    padding: 40px 20px 90px;
    box-sizing: border-box;
    width: 100%;
    overflow-x: clip;
  }
  .my-orders-container {
    max-width: 980px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* Breadcrumb */
  .orders-breadcrumb {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8C8275;
    margin-bottom: 24px;
  }
  .orders-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .orders-breadcrumb .breadcrumb-current {
    color: #1E1C19;
  }

  /* Header Banner */
  .orders-header-card {
    background: #FFFFFF;
    border: 1px solid #EAE5DE;
    border-radius: 12px;
    padding: 28px 32px;
    margin-bottom: 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.02);
    box-sizing: border-box;
    width: 100%;
  }
  .orders-header-main-col {
    flex: 1;
  }
  .orders-badge-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .orders-atelier-badge {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: #FAF7F2;
    border: 1px solid #EAE3D9;
    color: #9B7846;
    padding: 3px 10px;
    border-radius: 4px;
    display: inline-block;
  }
  .orders-header-perks-desktop {
    font-size: 11px;
    color: #8C8275;
    font-weight: 600;
  }
  .orders-header-action-mobile {
    display: none;
  }
  .orders-header-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 34px;
    font-weight: 600;
    color: #1E1C19;
    margin: 0 0 4px 0;
    line-height: 1.2;
  }
  .orders-header-subtitle {
    font-size: 13px;
    color: #6E6459;
    line-height: 1.4;
  }
  .orders-header-cta-btn-desktop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    background: #1E1C19;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    white-space: nowrap;
    transition: all 0.2s;
  }

  /* Filter Bar */
  .orders-filter-bar {
    display: flex !important;
    gap: 8px !important;
    margin-bottom: 22px !important;
    overflow-x: auto !important;
    white-space: nowrap !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
    padding: 2px 2px 8px 2px !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }
  .orders-filter-bar::-webkit-scrollbar {
    display: none !important;
  }
  .order-filter-pill {
    flex-shrink: 0 !important;
    white-space: nowrap !important;
    height: 34px !important;
    line-height: 32px !important;
    padding: 0 16px !important;
    border-radius: 17px !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    border: 1px solid #D6CEC3 !important;
    background: #FFFFFF !important;
    color: #4A4238 !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
    box-sizing: border-box !important;
  }
  .order-filter-pill.active {
    background: #1E1C19 !important;
    color: #FFFFFF !important;
    border-color: #1E1C19 !important;
    box-shadow: 0 2px 8px rgba(30, 28, 25, 0.15) !important;
  }

  /* Order Card */
  .orders-list-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }
  .luxury-order-card {
    background: #FFFFFF;
    border: 1px solid #EAE5DE;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.02);
    width: 100%;
    box-sizing: border-box;
  }

  /* Desktop Header Bar */
  .order-card-header-desktop {
    background: #FAF8F5;
    border-bottom: 1px solid #EAE5DE;
    padding: 14px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    box-sizing: border-box;
    width: 100%;
  }
  .order-header-meta-group {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
  .order-meta-col {
    display: flex;
    flex-direction: column;
  }
  .order-meta-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8C8275;
    margin-bottom: 2px;
  }
  .order-meta-val {
    font-weight: 600;
    color: #1E1C19;
  }
  .order-meta-val.total-price-val {
    font-weight: 700;
  }
  .order-header-number-group {
    text-align: right;
  }
  .order-number-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    font-weight: 700;
    color: #1E1C19;
    margin-top: 1px;
  }

  /* Mobile Header Bar (hidden on desktop) */
