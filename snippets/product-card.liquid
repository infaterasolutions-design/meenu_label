<div class="product-card {% unless product.available %}is-sold-out{% endunless %}" data-category="{{ product.type | handleize }} {{ product.tags | join: ' ' | handleize }}">
  <div class="card-thumb">
    {% unless product.available %}
      <span class="card-badge badge-sold-out">SOLD OUT</span>
    {% else %}
      {% if product.tags contains 'festive' %}
        <span class="card-badge badge-exclusive">FLAGSHIP HERO</span>
      {% elsif product.tags contains 'bestseller' %}
        <span class="card-badge badge-limited">BESTSELLER</span>
      {% endif %}
    {% endunless %}
    <button type="button" class="card-wishlist-btn" 
      data-wishlist-id="{{ product.id }}" 
      data-wishlist-title="{{ product.title | escape }}" 
      data-wishlist-price="{{ product.price | money | escape }}" 
      data-wishlist-image="{{ product.featured_image | default: product.images.first | image_url: width: 300 }}" 
      data-wishlist-url="{{ product.url }}" 
      onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist(this)" 
      title="Save to Wishlist" 
      aria-label="Save to Wishlist">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>
    <a href="{{ product.url }}">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" class="card-img-primary">
        {% if product.images.size > 1 %}
          <img src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" class="card-img-secondary">
        {% endif %}
      {% elsif product.images.size > 0 %}
        <img src="{{ product.images.first | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" class="card-img-primary">
        {% if product.images.size > 1 %}
          <img src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" class="card-img-secondary">
        {% endif %}
      {% else %}
        <div style="width: 100%; height: 100%; min-height: 280px; background: #FAF5ED; display: flex; align-items: center; justify-content: center; color: #8C827A; font-size: 13px; font-weight: 500;">
          {{ product.title }}
        </div>
      {% endif %}
    </a>
  </div>
  <div class="card-body">
    <a href="{{ product.url }}">
      <h3 class="card-title">{{ product.title }}</h3>
    </a>
    <div class="card-price-row">
      <div class="card-price-left">
        <span class="price-main">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <div class="card-price-compare-wrap">
            <span class="price-mrp">{{ product.compare_at_price | money }}</span>
            {% assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
            <span class="price-discount">{{ savings }}% OFF</span>
          </div>
        {% endif %}
      </div>
      {% if product.available %}
        <button type="button" class="snitch-plus-trigger" 
                data-product-id="{{ product.id }}"
                data-product-title="{{ product.title | escape }}"
                data-product-price="{{ product.price | money | escape }}"
                data-product-mrp="{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | escape }}{% endif %}"
                data-product-image="{{ product.featured_image | default: product.images.first | image_url: width: 400 }}"
                data-product-url="{{ product.url }}"
                data-product-tag="{% if product.tags contains 'festive' %}FLAGSHIP HERO{% else %}DROP 01 PIECE{% endif %}"
                onclick="event.preventDefault(); event.stopPropagation(); openQuickSizePopup(this)" 
                title="Select Size & Add to Bag" 
                aria-label="Select Size & Add to Bag">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="3" x2="12" y2="15"></line>
            <line x1="6" y1="9" x2="18" y2="9"></line>
            <line x1="4" y1="19" x2="20" y2="19"></line>
          </svg>
        </button>
      {% else %}
        <a class="snitch-notify-trigger whatsapp-notify-trigger" 
           href="https://wa.me/{{ settings.whatsapp_number | default: '918511616133' }}?text={{ 'Hi Meenu Label! Please notify me when "' | append: product.title | append: '" is back in stock. Please share restock timeline.' | url_encode }}"
           target="_blank"
           onclick="event.stopPropagation();" 
           title="Notify Me on WhatsApp When Restocked" 
           aria-label="Notify Me on WhatsApp When Restocked">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.301-.15-1.78-.879-2.056-.98-.276-.1-.477-.15-.678.15-.2.301-.778.98-.953 1.18-.175.2-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.896-.799-1.501-1.786-1.677-2.087-.175-.301-.019-.464.132-.614.135-.135.301-.351.451-.527.151-.176.201-.301.301-.502.101-.201.05-.376-.025-.527-.075-.15-.678-1.634-.929-2.237-.245-.588-.493-.508-.678-.518-.175-.01-.376-.01-.577-.01-.201 0-.527.075-.803.376s-1.054 1.029-1.054 2.511c0 1.482 1.079 2.913 1.23 3.114.15.201 2.122 3.24 5.14 4.544.718.31 1.279.496 1.716.635.722.23 1.379.197 1.9.119.58-.088 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.126-.276-.201-.577-.351z"/>
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2.05 21.95l4.908-1.353C8.414 21.49 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.61 0-3.13-.45-4.43-1.23l-.317-.189-2.906.801.815-2.833-.207-.328A8.152 8.152 0 0 1 3.8 12c0-4.52 3.68-8.2 8.2-8.2 4.52 0 8.2 3.68 8.2 8.2 0 4.52-3.68 8.2-8.2 8.2z"/>
          </svg>
          <span class="notify-btn-text">NOTIFY ON WHATSAPP</span>
        </a>
      {% endif %}
      <script type="application/json" class="product-variants-json">
        {{ product.variants | json }}
      </script>
    </div>
  </div>
</div>