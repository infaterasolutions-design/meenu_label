<div class="product-card">
  <div class="card-thumb">
    <button type="button" class="card-wishlist-btn" onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist('{{ product.id }}')" title="Save to Wishlist" aria-label="Save to Wishlist">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
    </button>
    <a href="{{ product.url }}">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
      {% else %}
        <div style="width: 100%; height: 100%; min-height: 280px; background: #FAF5ED; display: flex; align-items: center; justify-content: center; color: #8C827A; font-size: 13px; font-weight: 500;">
          {{ product.title }}
        </div>
      {% endif %}
    </a>
  </div>
  <div class="card-body">
    <a href="{{ product.url }}">
      <h3 class="card-title">{{ product.title }}</h3>
    </a>
    <div class="card-price-row">
      <span class="price-main">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span class="price-mrp" style="text-decoration: line-through; color: var(--text-muted); font-size: 13px; margin-left: 6px;">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <a href="{{ product.url }}" class="snitch-plus-trigger" title="Select size & add to bag" aria-label="Select size & add to bag">+</a>
    </div>
  </div>
</div>
